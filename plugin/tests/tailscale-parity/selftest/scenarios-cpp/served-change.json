        "User": { "1": { "ID": 1, "LoginName": "me@example.com", "DisplayName": "Me" } },
        "Peer": {
          "nodekey:aaaa": { "ID": "nAAA1CNTRL", "HostName": "alpha", "DNSName": "alpha.example.ts.net.",
                            "TailscaleIPs": ["100.64.0.2"], "Online": true, "ExitNodeOption": false, "UserID": 1 },
          "nodekey:bbbb": { "ID": "nBBB1CNTRL", "HostName": "bravo", "DNSName": "bravo.example.ts.net.",
