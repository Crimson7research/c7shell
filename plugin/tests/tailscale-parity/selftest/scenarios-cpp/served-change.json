    { "expect": { "id": "inserted", "model": { "name": "peers", "row": 1, "values": { "hostName": "bravo", "nodeId": "nBBB1CNTRL" } } } },
    { "expect": { "id": "kept", "model": { "name": "peers", "row": 2, "values": { "hostName": "charlie" } } } },
    { "expect": { "id": "no-reset", "signal": { "name": "peers.modelReset", "count": 0 } } },
    { "expect": { "id": "no-remove", "signal": { "name": "peers.rowsRemoved", "count": 0 } } },
