    { "mark": "before-idle-again" },
    { "fake": { "push_watch_line": "{\"Prefs\":{}}" } },
    { "wait": { "contract": { "exitNodeActive": false, "exitNodeOnline": false } } },
    { "expect": { "id": "idle-again-blocked-in-every-handler", "handlers": { "signals": ["exitNodeActiveChanged", "exitNodeBlockedChanged", "exitNodeIdChanged", "exitNodeNameChanged"], "since": "before-idle-again",
