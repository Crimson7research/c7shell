{
  "format": 1,
  "id": "http-08-an-empty-head-fails",
  "requirements": [
    "R-HTTP-08"
  ],
  "tag": "parity",
  "evidence": "harness-on-cpp",
  "clauses": [
    "A `/status` answered with the blank line alone (`\\r\\n\\r\\n`) and a close has headers that ended with no status line, which fails as a status failure: once `readErrorChanged` has fired, `readError` contains `/localapi/v0/status` and `state` reads `NoState`"
  ],
  "deferred": [
    "the numeric status and the counts: cpp-suite, the transport's own outcomes are not reachable through QML"
  ],
  "needs": [],
  "fake": {
    "rules": [
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/watch-ipn-bus?mask=18"
        },
        "stream": {
          "status": 200,
          "framing": "chunked"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/status"
        },
        "reply": {
          "status_line": "",
          "framing": "none"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/prefs"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/prefs.json"
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/suggest-exit-node"
        },
        "reply": {
          "status": 200,
          "body": {
            "json": {}
          }
        }
      }
    ]
  },
  "steps": [
    {
      "start": {}
    },
    {
      "wait": {
        "signal": {
          "name": "readErrorChanged",
          "at_least": 1
        }
      }
    },
    {
      "expect": {
        "id": "diagnosed",
        "contract": {
          "readError": {
            "contains": "/localapi/v0/status"
          }
        }
      }
    },
    {
      "expect": {
        "id": "lost",
        "contract": {
          "state": {
            "enum": "NoState"
          }
        }
      }
    }
  ],
  "on": {
    "cpp-286": {
      "result": "pass"
    },
    "rust": {
      "result": "pass"
    }
