{
  "format": 1,
  "id": "http-03-a-declared-zero-delivers-nothing",
  "requirements": [
    "R-HTTP-03"
  ],
  "tag": "parity",
  "evidence": "harness-on-cpp",
  "clauses": [
    "A 200 `/status` declaring `Content-Length: 0` and followed by the idle capture's bytes, after which the fake keeps the connection open, delivers an empty body at once: once `readErrorChanged` has fired, `readError` contains `/localapi/v0/status answered` (an empty body is not a status) and `state` reads `NoState`; the extra bytes are not the body, and the reply does not wait for a close"
  ],
  "deferred": [
    "the reply's exact bytes and the counts: cpp-suite, the transport's own outcomes are not reachable through QML"
  ],
  "needs": [],
  "fake": {
    "rules": [
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/watch-ipn-bus?mask=18"
        },
        "stream": {
          "status": 200,
          "framing": "chunked"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/status"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/status-idle.json"
          },
          "framing": {
            "content-length": 0
          },
          "then": "keep-open"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/prefs"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/prefs.json"
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/suggest-exit-node"
        },
        "reply": {
          "status": 200,
          "body": {
            "json": {}
          }
        }
      }
    ]
  },
  "steps": [
    {
      "start": {}
    },
    {
      "wait": {
        "signal": {
          "name": "readErrorChanged",
          "at_least": 1
        }
      }
    },
    {
      "expect": {
        "id": "diagnosed",
        "contract": {
          "readError": {
            "contains": "/localapi/v0/status answered"
          }
        }
      }
    },
    {
      "expect": {
        "id": "lost",
        "contract": {
          "state": {
            "enum": "NoState"
          }
        }
      }
    }
  ],
  "on": {
    "cpp-286": {
      "result": "pass"
    },
    "rust": {
      "result": "pass"
    }
  }
}
