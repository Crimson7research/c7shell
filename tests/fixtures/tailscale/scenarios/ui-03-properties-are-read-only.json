{
  "format": 1,
  "id": "ui-03-properties-are-read-only",
  "requirements": ["R-UI-03"],
  "tag": "parity",
  "evidence": "harness-on-cpp",
  "clauses": [
    "`Tailscale.wantRunning = true` fails; the assignment is synchronous, so right after it wantRunning reads the value it read before (false, from the served prefs) and wantRunningChanged has fired 0 times since just before the assignment"
  ],
  "needs": [],
  "fake": { "rules": [
    { "match": { "method": "GET", "target": "/localapi/v0/watch-ipn-bus?mask=18" },
      "stream": { "status": 200, "framing": "chunked" } },
    { "match": { "method": "GET", "target": "/localapi/v0/status" },
      "reply": { "status": 200, "body": { "file": "captures/status-idle.json" } } },
    { "match": { "method": "GET", "target": "/localapi/v0/prefs" },
      "reply": { "status": 200, "body": { "json": { "WantRunning": false } } } },
    { "match": { "method": "GET", "target": "/localapi/v0/suggest-exit-node" },
      "reply": { "status": 200, "body": { "json": {} } } }
  ] },
  "steps": [
    { "start": {} },
    { "wait": { "contract": { "state": { "enum": "Running" } } } },
    { "expect": { "id": "not-running-wanted", "precondition": true, "contract": { "wantRunning": false } } },
    { "mark": "before-assign" },
    { "expect": { "id": "assignment-fails", "assign": { "member": "wantRunning", "value": true } } },
    { "expect": { "id": "value-kept", "contract": { "wantRunning": false } } },
    { "expect": { "id": "nothing-announced", "signal": { "name": "wantRunningChanged", "count": 0, "since": "before-assign" } } },
    { "expect": { "id": "state-read-only", "assign": { "member": "state", "value": 1 } } },
    { "expect": { "id": "selfName-read-only", "assign": { "member": "selfName", "value": "x" } } },
    { "expect": { "id": "selfIp4-read-only", "assign": { "member": "selfIp4", "value": "x" } } },
    { "expect": { "id": "selfIp6-read-only", "assign": { "member": "selfIp6", "value": "x" } } },
    { "expect": { "id": "selfDnsName-read-only", "assign": { "member": "selfDnsName", "value": "x" } } },
    { "expect": { "id": "tailnet-read-only", "assign": { "member": "tailnet", "value": "x" } } },
    { "expect": { "id": "keyExpiry-read-only", "assign": { "member": "keyExpiry", "value": "2030-01-01T00:00:00Z" } } },
    { "expect": { "id": "exitNodeActive-read-only", "assign": { "member": "exitNodeActive", "value": true } } },
    { "expect": { "id": "exitNodeId-read-only", "assign": { "member": "exitNodeId", "value": "x" } } },
    { "expect": { "id": "exitNodeName-read-only", "assign": { "member": "exitNodeName", "value": "x" } } },
    { "expect": { "id": "exitNodeOnline-read-only", "assign": { "member": "exitNodeOnline", "value": true } } },
    { "expect": { "id": "exitNodeBlocked-read-only", "assign": { "member": "exitNodeBlocked", "value": true } } },
    { "expect": { "id": "issues-read-only", "assign": { "member": "issues", "value": ["x"] } } },
    { "expect": { "id": "issueCount-read-only", "assign": { "member": "issueCount", "value": 3 } } },
    { "expect": { "id": "peers-read-only", "assign": { "member": "peers", "value": null } } },
    { "expect": { "id": "exitNodes-read-only", "assign": { "member": "exitNodes", "value": null } } },
    { "expect": { "id": "recommendedExitNodeId-read-only", "assign": { "member": "recommendedExitNodeId", "value": "x" } } },
    { "expect": { "id": "writable-read-only", "assign": { "member": "writable", "value": false } } },
    { "expect": { "id": "writeError-read-only", "assign": { "member": "writeError", "value": "x" } } },
    { "expect": { "id": "readError-read-only", "assign": { "member": "readError", "value": "x" } } },
    { "expect": { "id": "exitNodeAllowLANAccess-read-only", "assign": { "member": "exitNodeAllowLANAccess", "value": true } } },
    { "expect": { "id": "acceptRoutes-read-only", "assign": { "member": "acceptRoutes", "value": true } } },
    { "expect": { "id": "acceptDns-read-only", "assign": { "member": "acceptDns", "value": false } } }
  ],
  "on": { "cpp-286": { "result": "pass" }, "rust": { "result": "pass" } }
}
