{
  "format": 1,
  "id": "http-07-a-chunked-body-without-its-last-chunk-fails",
  "requirements": [
    "R-HTTP-07"
  ],
  "tag": "parity",
  "evidence": "harness-on-cpp",
  "clauses": [
    "A chunked 200 `/status` carrying the whole idle capture but no zero-length last chunk, then a close, is a failure and not a partial success: once `readErrorChanged` has fired, `readError` is non-empty and `state` reads `NoState`"
  ],
  "deferred": [
    "the failure and reply counts: cpp-suite, the transport's own outcomes are read after the read barrier"
  ],
  "needs": [],
  "fake": {
    "rules": [
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/watch-ipn-bus?mask=18"
        },
        "stream": {
          "status": 200,
          "framing": "chunked"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/status"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/status-idle.json"
          },
          "framing": {
            "chunked": {
              "final": false
            }
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/prefs"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/prefs.json"
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/suggest-exit-node"
        },
        "reply": {
          "status": 200,
          "body": {
            "json": {}
          }
        }
      }
    ]
  },
  "steps": [
    {
      "start": {}
    },
    {
      "wait": {
        "signal": {
          "name": "readErrorChanged",
          "at_least": 1
        }
      }
    },
    {
      "expect": {
        "id": "diagnosed",
        "contract": {
          "readError": {
            "non_empty": true
          }
        }
      }
    },
    {
      "expect": {
        "id": "lost",
        "contract": {
          "state": {
            "enum": "NoState"
          }
        }
      }
    }
  ],
  "on": {
    "cpp-286": {
      "result": "pass"
    },
    "rust": {
      "result": "pass"
    }
  }
}
