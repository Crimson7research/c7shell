{
  "format": 1,
  "id": "http-04-a-watch-line-before-its-chunk-ends",
  "requirements": [
    "R-HTTP-04"
  ],
  "tag": "parity",
  "evidence": "harness-on-cpp",
  "clauses": [
    "From `Running`, with only the watch connected, the fake writes the chunk `c\\r\\n{\"State\":6}\\n` without its closing CRLF: the line it carries is delivered at once and starts a pass, so the fake records a second GET of `/status`",
    "Then the fake writes that CRLF, the whole chunk `c\\r\\n{\"State\":6}\\n\\r\\n` and the size line `5\\r\\n` of a chunk whose data has not arrived, once only the watch is connected again: the second line is delivered at once too, so the fake records a third GET of `/status`"
  ],
  "deferred": [
    "the event counts after each push: cpp-suite, the transport's own events are read after the read barrier"
  ],
  "needs": [],
  "fake": {
    "rules": [
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/watch-ipn-bus?mask=18"
        },
        "stream": {
          "status": 200,
          "framing": "chunked"
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/status"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/status-idle.json"
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/prefs"
        },
        "reply": {
          "status": 200,
          "body": {
            "file": "captures/prefs.json"
          }
        }
      },
      {
        "match": {
          "method": "GET",
          "target": "/localapi/v0/suggest-exit-node"
        },
        "reply": {
          "status": 200,
          "body": {
            "json": {}
          }
        }
      }
    ]
  },
  "steps": [
    {
      "start": {}
    },
    {
      "wait": {
        "contract": {
          "state": {
            "enum": "Running"
          }
        }
      }
    },
    {
      "wait": {
        "fake": {
          "recorded": {
            "method": "GET",
            "target": "/localapi/v0/watch-ipn-bus?mask=18"
          }
        }
      }
    },
    {
      "wait": {
        "fake": {
          "connected": 1
        }
      }
    },
    {
      "wait": {
        "fake": {
          "recorded": {
            "method": "GET",
            "target": "/localapi/v0/status"
          },
          "count": 1
        }
      }
    },
    {
      "fake": {
        "push_chunk": "c\r\n{\"State\":6}\n"
      }
    },
    {
      "wait": {
        "fake": {
          "recorded": {
            "method": "GET",
            "target": "/localapi/v0/status"
          },
          "count": 2
        }
      }
    },
    {
      "wait": {
        "fake": {
          "connected": 1
        }
      }
    },
    {
      "fake": {
        "push_chunk": "\r\nc\r\n{\"State\":6}\n\r\n5\r\n"
      }
    },
    {
      "wait": {
        "fake": {
          "recorded": {
            "method": "GET",
            "target": "/localapi/v0/status"
          },
          "count": 3
        }
      }
    },
    {
      "expect": {
        "id": "still-running",
        "contract": {
          "state": {
            "enum": "Running"
          }
        }
      }
    }
  ],
  "on": {
    "cpp-286": {
      "result": "pass"
    },
    "rust": {
      "result": "pass"
    }
  }
}
