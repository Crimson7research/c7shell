#!/usr/bin/env bash
# Copy the c7shell configs from /usr/share into the user's ~/.config.
# Neither hyprland nor quickshell reads config from /usr/share or
# XDG_CONFIG_DIRS, so this copy is what makes an installed package usable.
set -euo pipefail

share=${C7SHELL_SHARE:-/usr/share/c7shell}
conf=${XDG_CONFIG_HOME:-$HOME/.config}
state=${C7SHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/c7shell}
data=${XDG_DATA_HOME:-$HOME/.local/share}/c7shell
parts=(hypr quickshell/c7shell xdg-desktop-portal)
force=0
dry=0

usage() {
  cat <<USAGE
usage: c7shell-setup [--force] [--dry-run]

  --force     replace existing ~/.config/hypr, ~/.config/quickshell/c7shell and
              ~/.config/xdg-desktop-portal, keeping a timestamped .bak-<stamp>
              copy of each
  --dry-run   print what would happen and change nothing

env: C7SHELL_SHARE (default /usr/share/c7shell)
     XDG_CONFIG_HOME  (default \$HOME/.config)
     XDG_DATA_HOME    (default \$HOME/.local/share)
     C7SHELL_STATE    (default \$XDG_STATE_HOME/c7shell)

exit: 0 all parts installed, 3 nothing done because a target already exists
USAGE
}

while (($#)); do
  case $1 in
    --force) force=1 ;;
    --dry-run|-n) dry=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'c7shell-setup: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ((EUID == 0)) && [[ -z ${C7SHELL_ALLOW_ROOT:-} ]]; then
  echo "c7shell-setup: run this as your own user, not root" >&2
  exit 2
fi

for part in "${parts[@]}"; do
  [[ -d $share/$part ]] || { printf 'c7shell-setup: missing %s -- is the package installed?\n' "$share/$part" >&2; exit 1; }
done

run() { if ((dry)); then printf '  would: %s\n' "$*"; else "$@"; fi; }

# Replace a literal $HOME placeholder with a real path. Plain bash, not sed: the
# path is data, and a '#' or '&' in XDG_CONFIG_HOME is sed syntax.
rewrite_home() {
  local file=$1 from=$2 to=$3 text
  text=$(<"$file")
  printf '%s\n' "${text//"$from"/"$to"}" > "$file.tmp.$$"
  mv -f -- "$file.tmp.$$" "$file"
}

stamp=$(date +%Y%m%d%H%M%S)
skipped=0
installed=0
# Only the parts this run wrote may be claimed in the manifest below.
installed_parts=()

for part in "${parts[@]}"; do
  dst=$conf/$part
  if [[ -e $dst ]]; then
    if ((force)); then
      printf 'backing up %s -> %s.bak-%s\n' "$dst" "$dst" "$stamp"
      run mv -- "$dst" "$dst.bak-$stamp"
    else
      printf '%s already exists, left alone (rerun with --force to replace it)\n' "$dst" >&2
      skipped=1
      continue
    fi
  fi
  printf 'installing %s -> %s\n' "$share/$part" "$dst"
  run mkdir -p -- "$(dirname -- "$dst")"
  run cp -a -- "$share/$part" "$dst"
  installed=1
  installed_parts+=("$part")
done

# xdph has no variable expansion, so the shipped picker path is a $HOME
# placeholder that only becomes usable once it names a real directory.
xdph=$conf/hypr/xdph.conf
if [[ -f $xdph ]] && grep -q '\$HOME/\.config/quickshell' "$xdph"; then
  run rewrite_home "$xdph" '$HOME/.config/quickshell' "$conf/quickshell"
fi

# hyprlock expands the environment but nothing else, so the palette it sources
# is named by $HOME/.config -- which is only the config dir on a machine that
# has not moved it. Left byte-identical to the shipped file in the common case.
lockconf=$conf/hypr/hyprlock.conf
if [[ -f $lockconf && $conf != "$HOME/.config" ]] \
   && grep -q '\$HOME/\.config/hypr/hyprlock-palette\.conf' "$lockconf"; then
  run rewrite_home "$lockconf" '$HOME/.config/hypr/hyprlock-palette.conf' "$conf/hypr/hyprlock-palette.conf"
fi

# The palette and the preferred colour scheme live in appearance.json; Qt and
# KDE apps read kdeglobals, and apps that detect a dark desktop read GSettings
# through the portal, and the lock screen reads the palette file the exporter
# writes for it. The settings app exports to all three, but only when something
# changes -- so on a fresh install nothing has exported yet, dolphin comes up
# stock, every detecting app comes up light and the lock screen keeps the
# crimson defaults baked into hyprlock.conf. Seed it once here. Non-fatal: it is
# cosmetic, and it needs python3 plus the copy that was just made.
exporter=$conf/quickshell/c7shell/scripts/c7shell-theme-export.py
if [[ -f $exporter ]] && command -v python3 >/dev/null; then
  if ((dry)); then
    printf '  would: python3 %s   (seed ~/.config/kdeglobals, the lock screen palette and the color-scheme preference)\n' "$exporter"
  else
    printf 'exporting the palette to %s/kdeglobals and %s/hypr/hyprlock-palette.conf, and the color-scheme preference\n' "$conf" "$conf"
    python3 "$exporter" || printf 'c7shell-setup: the appearance export failed; Qt apps keep their own colours, the lock screen keeps its default crimson and apps that detect a theme stay light\n' >&2
  fi
fi

# The launcher's "actions" provider lists every executable directly in here as
# a runnable row. It lives under the data dir rather than in the config copy
# because --force moves the whole config tree aside, which would take a user's
# scripts with it. Create it empty so there is somewhere obvious to drop one:
# an absent directory just yields no rows and no explanation.
printf 'creating %s   (drop executable scripts here to get launcher rows)\n' "$data/scripts"
run mkdir -p -- "$data/scripts"

# arch-update elevates with sudo unless told otherwise, and a terminal sudo
# asks on the terminal. run0 asks polkit, so `arch-update` gets the shell's own
# prompt -- fingerprint, and a password field that is live at once. The file is
# the user's (bin/c7up reads it for the same reason), so this only fills in an
# elevation command nobody chose: an explicit PrivilegeElevationCommand, even
# sudo, is left exactly as it is.
au=$conf/arch-update/arch-update.conf
if ! grep -qs '^[[:space:]]*PrivilegeElevationCommand=' "$au"; then
  printf 'setting PrivilegeElevationCommand=run0 in %s   (arch-update prompts through polkit)\n' "$au"
  run mkdir -p -- "$(dirname -- "$au")"
  if ((dry)); then
    printf '  would: append PrivilegeElevationCommand=run0 to %s\n' "$au"
  else
    printf 'PrivilegeElevationCommand=run0\n' >> "$au"
  fi
fi

# paru the same way: its [bin] Sudo is what `paru -Syu` runs pacman through.
# paru reads ~/.config/paru/paru.conf INSTEAD of /etc/paru.conf, not on top of
# it, so a new user file starts as a copy of the system one -- otherwise the
# options there (Devel, BottomUp, ...) would silently stop applying.
pc=$conf/paru/paru.conf
if command -v paru >/dev/null && ! grep -qs '^[[:space:]]*Sudo[[:space:]]*=' "$pc"; then
  printf 'setting Sudo = run0 in %s   (paru prompts through polkit)\n' "$pc"
  run mkdir -p -- "$(dirname -- "$pc")"
  if ((dry)); then
    printf '  would: append [bin] Sudo = run0 to %s\n' "$pc"
  else
    [[ -e $pc || ! -r ${C7SHELL_PARU_SYSCONF:-/etc/paru.conf} ]] \
      || cp -- "${C7SHELL_PARU_SYSCONF:-/etc/paru.conf}" "$pc"
    printf '\n[bin]\nSudo = run0\n' >> "$pc"
  fi
fi

# sudo itself has no elevation setting to point at run0, so an interactive
# shell gets a `sudo` function that hands plain commands to run0 -- one popup
# for every permission prompt, not a password line on the terminal. One guarded
# source line per rc file that exists; the function itself ships in the
# package, so an upgrade changes it without touching the rc file again.
sudo_snippet=${C7SHELL_SUDO_SNIPPET:-/usr/lib/c7shell/sudo-run0.sh}
printf -v q_snippet '%q' "$sudo_snippet"
sudo_line="[ -r $q_snippet ] && . $q_snippet   # c7shell: sudo asks through polkit (run0)"
for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.bashrc"; do
  [[ -f $rc ]] || continue
  grep -qsF "$sudo_snippet" "$rc" && continue
  printf 'adding the run0 sudo to %s\n' "$rc"
  if ((dry)); then
    printf '  would: append %s\n' "$sudo_line"
  else
    printf '\n%s\n' "$sudo_line" >> "$rc"
  fi
done

# Record the hash of every file as installed. c7shell-upgrade compares against
# this to tell "you edited it" from "it is just an old copy" -- without it, a
# later upgrade has to assume every difference is a local edit and can only
# park new versions as .new files.
#
# This runs even when every part was skipped, and BEFORE the early exit below.
# It used to be the other way round, which meant the one situation that most
# needs a baseline -- an existing config this run left alone -- was the only
# one that never recorded one. The result was an upgrade that parked a .new
# beside every shipped file it did not recognise, leaving a config that is
# half one version and half another. A mixed config does not degrade: QML
# resolves imports across the whole tree, so an old shell.qml next to a new
# module directory fails the load and the desktop comes up with no bar.
#
# Only files this run actually wrote are claimed as ours. For a part that was
# skipped we record nothing rather than guessing, so a genuine local edit is
# still never overwritten -- the difference is that the upgrade now knows the
# two cases apart instead of assuming the worst about both.
#
# Rows for a skipped part are carried over from the last manifest: this run
# cannot rebuild them, and dropping them is the same "no baseline" failure.
# Only files the package ships are recorded -- the lock palette the exporter
# generates beside them is not ours to compare, and claiming it would let an
# upgrade delete it as "dropped upstream". Written to a temp file and moved into
# place, so an interrupted run leaves the old manifest, never half of one.
in_part() { local p; for p in "${@:2}"; do [[ $1 == "$p"/* ]] && return 0; done; return 1; }
if ((dry == 0)); then
  mkdir -p -- "$state"
  new_manifest=$state/manifest.tmp.$$
  trap 'rm -f -- "$new_manifest"' EXIT
  {
    if [[ -f $state/manifest ]]; then
      while IFS=$'\t' read -r rel h; do
        [[ -n $rel ]] || continue
        # Rewritten below, or no longer shipped (the old palette row).
        in_part "$rel" "${installed_parts[@]+"${installed_parts[@]}"}" && continue
        if [[ -f $share/$rel ]]; then printf '%s\t%s\n' "$rel" "$h"; fi
      done < "$state/manifest"
    fi
    for part in "${installed_parts[@]+"${installed_parts[@]}"}"; do
      [[ -d $conf/$part ]] || continue
      while read -r f; do
        rel=${f#"$conf/"}
        [[ -f $share/$rel ]] || continue
        printf '%s\t%s\n' "$rel" "$(sha256sum -- "$f" | cut -d' ' -f1)"
      done < <(find "$conf/$part" -type f ! -name '*.new' | sort)
    done
  } | sort > "$new_manifest"
  mv -f -- "$new_manifest" "$state/manifest"
fi

if ((installed == 0 && skipped)); then
  printf '\nNothing was copied. To take the shipped configs over what is there:\n'
  printf '  c7shell-setup --force        (backs the current ones up first)\n'
  printf 'or, to update in place without losing your edits:\n'
  printf '  c7shell-upgrade --config-only\n'
  exit 3
fi

cat <<'MSG'

Done. Log out and pick the "c7shell" session in your display manager, or
start it from a TTY with: start-hyprland

Notes:
  - The shell is the named quickshell config "c7shell": it runs as
    `qs -c c7shell` and leaves any other ~/.config/quickshell config alone.
  - ~/.config/hypr/appearance.json is written by the settings app on first
    change; until then the defaults in conf/appearance.lua apply.
  - Executables in ~/.local/share/c7shell/scripts show up in the launcher
    under the "actions" provider.
  - Logitech thumb-button gestures expect ~/.config/solaar/rules.yaml, which
    is yours to write; the autostart entry is harmless without it.
MSG
