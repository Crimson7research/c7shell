#!/usr/bin/env bash
# Copy the c7shell configs from /usr/share into the user's ~/.config.
# Neither hyprland nor quickshell reads config from /usr/share or
# XDG_CONFIG_DIRS, so this copy is what makes an installed package usable.
set -euo pipefail

share=${C7SHELL_SHARE:-/usr/share/c7shell}
conf=${XDG_CONFIG_HOME:-$HOME/.config}
state=${C7SHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/c7shell}
data=${XDG_DATA_HOME:-$HOME/.local/share}/c7shell
parts=(hypr quickshell/c7shell xdg-desktop-portal)
force=0
dry=0
uninstall=0

usage() {
  cat <<USAGE
usage: c7shell-setup [--force] [--dry-run]
       c7shell-setup --uninstall [--dry-run]

  --force     replace existing ~/.config/hypr, ~/.config/quickshell/c7shell and
              ~/.config/xdg-desktop-portal, keeping a timestamped .bak-<stamp>
              copy of each
  --dry-run   print what would happen and change nothing
  --uninstall remove the shipped files setup installed and you have not
              edited, and the sudo line it added to your shell rc files;
              keeps edited files, your own files and .bak-<stamp> copies

env: C7SHELL_SHARE (default /usr/share/c7shell)
     XDG_CONFIG_HOME  (default \$HOME/.config)
     XDG_DATA_HOME    (default \$HOME/.local/share)
     C7SHELL_STATE    (default \$XDG_STATE_HOME/c7shell)

exit: 0 all parts installed, 3 nothing done because a target already exists,
      4 some parts installed and others left alone because they already exist
      --uninstall: 0 done or nothing to remove, 1 a file it meant to remove,
      an rc file it meant to edit or the manifest could not be changed or
      read, 2 bad options
USAGE
}

while (($#)); do
  case $1 in
    --force) force=1 ;;
    --dry-run|-n) dry=1 ;;
    --uninstall) uninstall=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'c7shell-setup: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ((EUID == 0)) && [[ -z ${C7SHELL_ALLOW_ROOT:-} ]]; then
  echo "c7shell-setup: run this as your own user, not root" >&2
  exit 2
fi

run() { if ((dry)); then printf '  would: %s\n' "$*"; else "$@"; fi; }

sudo_snippet=${C7SHELL_SUDO_SNIPPET:-/usr/lib/c7shell/sudo-run0.sh}
rc_files=("${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.bashrc")

# --uninstall (#19): the manifest is the list of files this script wrote, with
# the hash each had when it did. A file whose hash still matches is unedited
# and goes, with the .new an upgrade parked beside it; anything else under the
# parts is the user's and stays. The command ships in the package, so it has
# to run before `pacman -R c7shell`.
sudo_marker='# c7shell: sudo asks through polkit (run0)'
bottomup_marker='# c7shell: BottomUp (paru lists AUR search results first)'

# would <dry-run verb> <done verb> -- the verb for a report line.
would() { if ((dry)); then printf 'would %s' "$1"; else printf '%s' "$2"; fi; }

# list <heading> <item>... -- a report section, printed only when it has items.
list() { (($# > 1)) || return 0; printf '\n%s\n' "$1"; shift; printf '  %s\n' "$@"; }

# Only a file at exactly $conf/<rel> is ours. Through a symlinked directory --
# a dotfile manager's ~/.config/hypr -- the file lives in the user's own tree,
# and a ../ in a row would leave the config dir altogether.
inside_conf() {
  [[ $(realpath -m -- "$1") == "$(realpath -m -- "$conf")/$2" && ! -L $1 ]]
}

# Sets removed, kept, parked, behind, failed, gone (what went, or under
# --dry-run would go), dirs (the parents of what went)
# and rows (every manifest row except those of the files removed) for the
# caller. A row whose file is not there stays: the manifest does not say which
# config dir it describes, so a run against another XDG_CONFIG_HOME, or with a
# part moved aside, must not erase the baseline of the real one. A .new goes
# only with an unedited file: beside an edited one it is the version the user
# was told to merge, and may already hold that merge.
uninstall_files() {
  local rel h f
  while IFS=$'\t' read -r rel h; do
    [[ -n $rel ]] || continue
    f=$conf/$rel
    if [[ -e $f || -e $f.new ]] && ! inside_conf "$f" "$rel"; then
      behind+=("$f")
    elif [[ -f $f && $(sha256sum -- "$f" | cut -d' ' -f1) == "$h" ]]; then
      if remove "$f" && { [[ ! -e $f.new ]] || remove "$f.new"; }; then
        removed=$((removed + 1)); dirs+=("${f%/*}"); gone+=("$f" "$f.new"); continue
      fi
      failed+=("$f")
    else
      [[ -f $f ]] && kept+=("$f")
      [[ -e $f.new ]] && parked+=("$f.new")
    fi
    rows+=("$rel"$'\t'"$h")
  done < "$state/manifest"
}

# rm, or under --dry-run what rm would do. Checked: errexit is off inside a
# function its caller tests.
remove() { run rm -f -- "$1" 2>/dev/null && [[ $dry == 1 || ! -e $1 ]]; }

# The lock palette is not in the manifest -- it is generated, and upgrade must
# not compare it -- but it is c7shell's (c7shell-upgrade's generated()). Left
# behind, it alone keeps ~/.config/hypr alive, and the next setup then skips
# the whole hypr part as somebody else's config.
remove_generated() {
  local f=$conf/hypr/hyprlock-palette.conf
  [[ -f $f ]] && inside_conf "$f" hypr/hyprlock-palette.conf || return 0
  if remove "$f"; then dirs+=("${f%/*}"); gone+=("$f"); else failed+=("$f"); fi
}

# The directories the removals emptied, deepest first, up to but never
# including the config dir. An empty directory nothing was removed from is
# the user's, and stays.
prune_dirs() {
  local d
  ((dry)) && return 0
  while IFS= read -r d; do
    while [[ $d == "$conf"/* ]] && rmdir -- "$d" 2>/dev/null; do d=${d%/*}; done
  done < <(printf '%s\n' "$@" | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2- | uniq)
}

# Setup appended "\n<line>\n"; take out the line and the blank before it, and
# nothing else, byte for byte. awk in the C locale passes any byte through,
# where grep calls a file with one invalid UTF-8 byte binary and drops the
# line. The result replaces the real file by rename, so a failure leaves it
# whole; the rename is of the symlink's target, so a dotfile manager's link
# stays a link.
drop_sudo_line() {
  local target tmpf
  target=$(realpath -- "$1") && [[ -w $target ]] || return 1
  tmpf=$(mktemp "$target.c7shell.XXXXXX") || return 1
  if LC_ALL=C awk -v m="$sudo_marker" '
       pend { pend = 0; if (index($0, m)) next; print "" }
       $0 == "" { pend = 1; next }
       index($0, m) { next }
       { print }
       END { if (pend) print "" }' "$target" > "$tmpf" \
     && { [[ -z $(tail -c1 -- "$target") ]] || truncate -s -1 -- "$tmpf"; } \
     && chmod --reference="$target" -- "$tmpf" \
     && { ((EUID)) || chown --reference="$target" -- "$tmpf"; } \
     && mv -f -- "$tmpf" "$target"; then
    return 0
  fi
  rm -f -- "$tmpf"
  return 1
}

# What setup may have written that uninstall cannot claim: lines without a
# marker, the files the theme export rewrote (other desktops read them too, so
# the next setup inherits the palette until they go), the backups, and every
# other file still under the parts -- the shell's own state, per-file backups,
# the user's files. Named only where they are actually there: a part whose
# directory survives is one the next setup skips.
report_leftovers() {
  local au=$conf/arch-update/arch-update.conf pc=$conf/paru/paru.conf left=() rest=() b part
  grep -qsx 'PrivilegeElevationCommand=run0' "$au" && left+=("PrivilegeElevationCommand=run0 in $au")
  grep -qsE '^[[:space:]]*Sudo[[:space:]]*=[[:space:]]*run0' "$pc" && left+=("Sudo = run0 in $pc")
  grep -qsxF "$bottomup_marker" "$pc" && left+=("the BottomUp block c7shell-setup added to $pc")
  grep -qs 'C7Shell' "$conf/kdeglobals" && left+=("the C7Shell colours in $conf/kdeglobals")
  # Each file named only while it holds a key the export sets.
  for b in "$conf/kcminputrc:^cursorTheme=" \
           "$conf/gtk-3.0/settings.ini:^gtk-application-prefer-dark-theme" \
           "$conf/gtk-4.0/settings.ini:^gtk-application-prefer-dark-theme" \
           "$conf/imv/config:^overlay_background_alpha" "$data/../color-schemes/C7Shell.colors:."; do
    grep -qs -- "${b##*:}" "${b%:*}" && left+=("$(realpath -m -- "${b%:*}")   (the theme export writes to it)")
  done
  b=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null) || b=
  [[ -z $b || $b == "'default'" ]] \
    || left+=("the GNOME color-scheme setting, now $b (gsettings org.gnome.desktop.interface color-scheme)")
  while IFS= read -r b; do left+=("$b"); done \
    < <(compgen -G "$conf/*.bak-*"; compgen -G "$conf/quickshell/*.bak-*")
  [[ -d $data/scripts ]] && left+=("$data/scripts")
  for part in "${parts[@]}"; do
    [[ -d $conf/$part && ! -L $conf/$part ]] || continue
    while IFS= read -r -d '' b; do
      listed "$b" ${kept[@]+"${kept[@]}"} ${parked[@]+"${parked[@]}"} ${failed[@]+"${failed[@]}"} \
        ${gone[@]+"${gone[@]}"} || rest+=("$b")
    done < <(find "$conf/$part" -type f -print0 | sort -z)
  done
  list 'Left as they are -- they may be your own choice, so remove them by hand if not:' \
    ${left[@]+"${left[@]}"}
  list 'Also still in the c7shell parts (until these go, the next c7shell-setup skips the part):' \
    ${rest[@]+"${rest[@]}"}
}

# plural <n> <noun> -- "1 row", "2 rows".
plural() { if (($1 == 1)); then printf '1 %s' "$2"; else printf '%d %ss' "$1" "$2"; fi; }

# listed <item> <list>... -- whether the item is one of the list.
listed() { local x=$1 y; shift; for y; do [[ $x == "$y" ]] && return 0; done; return 1; }

# Keeps the rows of the files that stay, so a later setup or upgrade still
# knows which of them are edits; no rows left, no manifest.
rewrite_manifest() {
  local m=$state/manifest
  ((dry)) && return 0
  if (($#)); then
    # Temp and rename, as setup writes it: an interrupted run keeps the old one.
    printf '%s\n' "$@" > "$m.tmp.$$" 2>/dev/null && mv -f -- "$m.tmp.$$" "$m" 2>/dev/null \
      || { rm -f -- "$m.tmp.$$"; failed+=("$m"); }
  else
    rm -f -- "$m" 2>/dev/null && [[ ! -e $m ]] || failed+=("$m")
  fi
}

uninstall_config() {
  local removed=0 kept=() parked=() behind=() dirs=() rows=() failed=() gone=() rc
  # The rc line and the leftovers do not need the manifest: an install older
  # than it, or a wiped ~/.local/state, still gets both.
  if [[ -f $state/manifest && ! -r $state/manifest ]]; then
    # Read as empty, it would remove nothing and then delete the manifest --
    # the baseline of every file still installed.
    printf 'c7shell-setup: cannot read %s; nothing changed\n' "$state/manifest" >&2
    return 1
  elif [[ -f $state/manifest ]]; then
    uninstall_files
    remove_generated
    prune_dirs ${dirs[@]+"${dirs[@]}"}
    rewrite_manifest ${rows[@]+"${rows[@]}"}
    printf '%s %d unedited c7shell files from %s\n' "$(would remove removed)" "$removed" "$conf"
    # The rows of what stays are kept, so a later setup or upgrade still knows
    # those files as edits; so are rows whose file is not in this config dir.
    ((${#rows[@]} == 0)) || listed "$state/manifest" ${failed[@]+"${failed[@]}"} \
      || printf '%s %s in %s: for the files that stay, and any not found in %s\n' \
      "$(would keep kept)" "$(plural ${#rows[@]} row)" "$state/manifest" "$conf"
  else
    printf 'no install recorded in %s, so no config files %s\n' "$state/manifest" "$(would 'be removed' 'are removed')"
  fi
  for rc in "${rc_files[@]}"; do
    grep -qsF "$sudo_marker" "$rc" || continue
    if ((dry)); then printf 'would remove the run0 sudo line from %s\n' "$rc"
    elif drop_sudo_line "$rc"; then printf 'removed the run0 sudo line from %s\n' "$rc"
    else failed+=("$rc"); fi
  done
  list 'Kept, because you edited them:' ${kept[@]+"${kept[@]}"}
  list 'Kept, the new versions an upgrade parked for you to merge:' ${parked[@]+"${parked[@]}"}
  list "Kept, because they resolve outside $conf (a symlink, or a ../ in the manifest):" ${behind[@]+"${behind[@]}"}
  report_leftovers
  ((${#failed[@]} == 0)) && return 0
  printf '\nc7shell-setup: could not change these. Remove a listed config file, or the line\nending in "%s" from a listed rc file, by hand; a listed manifest is left as it\nwas, which is safe:\n' "$sudo_marker" >&2
  printf '  %s\n' "${failed[@]}" >&2
  return 1
}
if ((uninstall)); then
  ((force == 0)) || { echo 'c7shell-setup: --uninstall takes no --force' >&2; exit 2; }
  uninstall_config || exit 1
  exit 0
fi

for part in "${parts[@]}"; do
  [[ -d $share/$part ]] || { printf 'c7shell-setup: missing %s -- is the package installed?\n' "$share/$part" >&2; exit 1; }
done

# Replace a literal $HOME placeholder with a real path. Plain bash, not sed: the
# path is data, and a '#' or '&' in XDG_CONFIG_HOME is sed syntax.
rewrite_home() {
  local file=$1 from=$2 to=$3 text
  text=$(<"$file")
  printf '%s\n' "${text//"$from"/"$to"}" > "$file.tmp.$$"
  mv -f -- "$file.tmp.$$" "$file"
}

stamp=$(date +%Y%m%d%H%M%S)
skipped=0
installed=0
# Only the parts this run wrote may be claimed in the manifest below.
installed_parts=()
skipped_parts=()

# Hyprland writes a stub ~/.config/hypr/hyprland.conf the first time it starts
# with no config, marked "autogenerated = 1". Anyone who tried the session
# before running this has one, and it is not a config worth keeping over ours.
hypr_autogenerated() {
  local d=$conf/hypr f
  [[ -d $d ]] || return 1
  for f in "$d"/* "$d"/.[!.]*; do
    [[ -e $f ]] || continue
    [[ $f == "$d/hyprland.conf" ]] || return 1
  done
  grep -qE '^[[:space:]]*autogenerated[[:space:]]*=[[:space:]]*1' "$d/hyprland.conf" 2>/dev/null
}

for part in "${parts[@]}"; do
  dst=$conf/$part
  if [[ -e $dst ]]; then
    if ((force)) || { [[ $part == hypr ]] && hypr_autogenerated; }; then
      printf 'backing up %s -> %s.bak-%s\n' "$dst" "$dst" "$stamp"
      run mv -- "$dst" "$dst.bak-$stamp"
    else
      printf '%s already exists, left alone (rerun with --force to replace it)\n' "$dst" >&2
      skipped=1
      skipped_parts+=("$part")
      continue
    fi
  fi
  printf 'installing %s -> %s\n' "$share/$part" "$dst"
  run mkdir -p -- "$(dirname -- "$dst")"
  run cp -a -- "$share/$part" "$dst"
  installed=1
  installed_parts+=("$part")
done

# xdph has no variable expansion, so the shipped picker path is a $HOME
# placeholder that only becomes usable once it names a real directory.
xdph=$conf/hypr/xdph.conf
if [[ -f $xdph ]] && grep -q '\$HOME/\.config/quickshell' "$xdph"; then
  run rewrite_home "$xdph" '$HOME/.config/quickshell' "$conf/quickshell"
fi

# hyprlock expands the environment but nothing else, so the palette it sources
# is named by $HOME/.config -- which is only the config dir on a machine that
# has not moved it. Left byte-identical to the shipped file in the common case.
lockconf=$conf/hypr/hyprlock.conf
if [[ -f $lockconf && $conf != "$HOME/.config" ]] \
   && grep -q '\$HOME/\.config/hypr/hyprlock-palette\.conf' "$lockconf"; then
  run rewrite_home "$lockconf" '$HOME/.config/hypr/hyprlock-palette.conf' "$conf/hypr/hyprlock-palette.conf"
fi

# The palette and the preferred colour scheme live in appearance.json; Qt and
# KDE apps read kdeglobals, and apps that detect a dark desktop read GSettings
# through the portal, and the lock screen reads the palette file the exporter
# writes for it. The settings app exports to all three, but only when something
# changes -- so on a fresh install nothing has exported yet, dolphin comes up
# stock, every detecting app comes up light and the lock screen keeps the
# crimson defaults baked into hyprlock.conf. Seed it once here. Non-fatal: it is
# cosmetic, and it needs python3 plus the copy that was just made.
exporter=$conf/quickshell/c7shell/scripts/c7shell-theme-export.py
if [[ -f $exporter ]] && command -v python3 >/dev/null; then
  if ((dry)); then
    printf '  would: python3 %s   (seed ~/.config/kdeglobals, the lock screen palette and the color-scheme preference)\n' "$exporter"
  else
    printf 'exporting the palette to %s/kdeglobals and %s/hypr/hyprlock-palette.conf, and the color-scheme preference\n' "$conf" "$conf"
    python3 "$exporter" || printf 'c7shell-setup: the appearance export failed; Qt apps keep their own colours, the lock screen keeps its default crimson and apps that detect a theme stay light\n' >&2
  fi
fi

# The launcher's "actions" provider lists every executable directly in here as
# a runnable row. It lives under the data dir rather than in the config copy
# because --force moves the whole config tree aside, which would take a user's
# scripts with it. Create it empty so there is somewhere obvious to drop one:
# an absent directory just yields no rows and no explanation.
printf 'creating %s   (drop executable scripts here to get launcher rows)\n' "$data/scripts"
run mkdir -p -- "$data/scripts"

# arch-update elevates with sudo unless told otherwise, and a terminal sudo
# asks on the terminal. run0 asks polkit, so `arch-update` gets the shell's own
# prompt -- fingerprint, and a password field that is live at once. The file is
# the user's (bin/c7up reads it for the same reason), so this only fills in an
# elevation command nobody chose: an explicit PrivilegeElevationCommand, even
# sudo, is left exactly as it is.
au=$conf/arch-update/arch-update.conf
if ! grep -qs '^[[:space:]]*PrivilegeElevationCommand=' "$au"; then
  printf 'setting PrivilegeElevationCommand=run0 in %s   (arch-update prompts through polkit)\n' "$au"
  run mkdir -p -- "$(dirname -- "$au")"
  if ((dry)); then
    printf '  would: append PrivilegeElevationCommand=run0 to %s\n' "$au"
  else
    printf 'PrivilegeElevationCommand=run0\n' >> "$au"
  fi
fi

# paru the same way: its [bin] Sudo is what `paru -Syu` runs pacman through.
# paru reads ~/.config/paru/paru.conf INSTEAD of /etc/paru.conf, not on top of
# it, so a new user file starts as a copy of the system one -- otherwise the
# options there (Devel, BottomUp, ...) would silently stop applying.
pc=$conf/paru/paru.conf
pc_dir=$(dirname -- "$pc")
paru_sudo_re='^[[:space:]]*Sudo[[:space:]]*='
paru_bottomup_re='^[[:space:]]*#?[[:space:]]*BottomUp[[:space:]]*(=.*)?$'
# A user file setup cannot read is one it cannot check, so every run would
# append the same lines again. One it cannot write -- read-only, as in a
# dotfiles store, a symlink to nothing yet, or not there yet in a directory
# setup cannot write -- would stop setup before the rc files and the manifest,
# so it is named only when it lacks a line setup adds. Either way setup adds
# nothing to it.
paru=0
if command -v paru >/dev/null; then
  if [[ -e $pc && ! -r $pc ]]; then
    printf 'c7shell-setup: cannot read %s, so its Sudo and BottomUp are left as they are\n' "$pc" >&2
  elif [[ -L $pc && ! -e $pc ]] || [[ -e $pc && ! -w $pc ]] \
       || [[ ! -e $pc && -d $pc_dir && ! ( -w $pc_dir && -x $pc_dir ) ]]; then
    grep -qs "$paru_sudo_re" "$pc" && grep -qsE "$paru_bottomup_re" "$pc" \
      || printf 'c7shell-setup: cannot write %s, so its Sudo and BottomUp are left as they are\n' "$pc" >&2
  else
    paru=1
  fi
fi
if ((paru)) && ! grep -qs "$paru_sudo_re" "$pc"; then
  printf 'setting Sudo = run0 in %s   (paru prompts through polkit)\n' "$pc"
  run mkdir -p -- "$pc_dir"
  if ((dry)); then
    printf '  would: append [bin] Sudo = run0 to %s\n' "$pc"
  else
    [[ -e $pc || ! -r ${C7SHELL_PARU_SYSCONF:-/etc/paru.conf} ]] \
      || cp -- "${C7SHELL_PARU_SYSCONF:-/etc/paru.conf}" "$pc"
    printf '\n[bin]\nSudo = run0\n' >> "$pc"
  fi
fi

# BottomUp prints `paru <term>` search results bottom to top, the AUR's first
# (paru.conf(5)). Arch's /etc/paru.conf sets it and the copy above carries it
# over; a user paru.conf from before setup gets it here. A commented-out
# #BottomUp, or a BottomUp = <value>, is a choice and stays. paru reads a
# second [options] section as more options. The marker line above it is how
# --uninstall tells this BottomUp from one the user or /etc/paru.conf set. A dry
# run made no copy, so it asks the system file.
pc_src=$pc
((dry)) && [[ ! -e $pc ]] && pc_src=${C7SHELL_PARU_SYSCONF:-/etc/paru.conf}
if ((paru)) && ! grep -qsE "$paru_bottomup_re" "$pc_src"; then
  printf 'setting BottomUp in %s   (paru lists AUR search results first)\n' "$pc"
  if ((dry)); then
    printf '  would: append [options] BottomUp to %s\n' "$pc"
  else
    printf '\n%s\n[options]\nBottomUp\n' "$bottomup_marker" >> "$pc"
  fi
fi

# sudo itself has no elevation setting to point at run0, so an interactive
# shell gets a `sudo` function that hands plain commands to run0 -- one popup
# for every permission prompt, not a password line on the terminal. One guarded
# source line per rc file that exists; the function itself ships in the
# package, so an upgrade changes it without touching the rc file again.
printf -v q_snippet '%q' "$sudo_snippet"
sudo_line="[ -r $q_snippet ] && . $q_snippet   $sudo_marker"
for rc in "${rc_files[@]}"; do
  [[ -f $rc ]] || continue
  grep -qsF "$sudo_snippet" "$rc" && continue
  printf 'adding the run0 sudo to %s\n' "$rc"
  if ((dry)); then
    printf '  would: append %s\n' "$sudo_line"
  else
    printf '\n%s\n' "$sudo_line" >> "$rc"
  fi
done

# Record the hash of every file as installed. c7shell-upgrade compares against
# this to tell "you edited it" from "it is just an old copy" -- without it, a
# later upgrade has to assume every difference is a local edit and can only
# park new versions as .new files.
#
# This runs even when every part was skipped, and BEFORE the early exit below.
# It used to be the other way round, which meant the one situation that most
# needs a baseline -- an existing config this run left alone -- was the only
# one that never recorded one. The result was an upgrade that parked a .new
# beside every shipped file it did not recognise, leaving a config that is
# half one version and half another. A mixed config does not degrade: QML
# resolves imports across the whole tree, so an old shell.qml next to a new
# module directory fails the load and the desktop comes up with no bar.
#
# Only files this run actually wrote are claimed as ours. For a part that was
# skipped we record nothing rather than guessing, so a genuine local edit is
# still never overwritten -- the difference is that the upgrade now knows the
# two cases apart instead of assuming the worst about both.
#
# Rows for a skipped part are carried over from the last manifest: this run
# cannot rebuild them, and dropping them is the same "no baseline" failure.
# Only files the package ships are recorded -- the lock palette the exporter
# generates beside them is not ours to compare, and claiming it would let an
# upgrade delete it as "dropped upstream". Written to a temp file and moved into
# place, so an interrupted run leaves the old manifest, never half of one.
in_part() { local p; for p in "${@:2}"; do [[ $1 == "$p"/* ]] && return 0; done; return 1; }
if ((dry == 0)); then
  mkdir -p -- "$state"
  new_manifest=$state/manifest.tmp.$$
  trap 'rm -f -- "$new_manifest"' EXIT
  {
    if [[ -f $state/manifest ]]; then
      while IFS=$'\t' read -r rel h; do
        [[ -n $rel ]] || continue
        # Rewritten below, or no longer shipped (the old palette row).
        in_part "$rel" "${installed_parts[@]+"${installed_parts[@]}"}" && continue
        if [[ -f $share/$rel ]]; then printf '%s\t%s\n' "$rel" "$h"; fi
      done < "$state/manifest"
    fi
    for part in "${installed_parts[@]+"${installed_parts[@]}"}"; do
      [[ -d $conf/$part ]] || continue
      while read -r f; do
        rel=${f#"$conf/"}
        [[ -f $share/$rel ]] || continue
        printf '%s\t%s\n' "$rel" "$(sha256sum -- "$f" | cut -d' ' -f1)"
      done < <(find "$conf/$part" -type f ! -name '*.new' | sort)
    done
  } | sort > "$new_manifest"
  mv -f -- "$new_manifest" "$state/manifest"
fi

if ((installed == 0 && skipped)); then
  printf '\nNothing was copied. To take the shipped configs over what is there:\n'
  printf '  c7shell-setup --force        (backs the current ones up first)\n'
  printf 'or, to update in place without losing your edits:\n'
  printf '  c7shell-upgrade --config-only\n'
  exit 3
fi

# Some parts went in and some did not: a c7shell shell over a stock or foreign
# hypr config is not a c7shell session, so this is not "Done".
if ((skipped)); then
  printf '\nOnly part of c7shell was installed. Left alone, because they already exist:\n'
  printf '  %s\n' "${skipped_parts[@]/#/$conf/}"
  printf 'The session will not be c7shell until they are replaced:\n'
  printf '  c7shell-setup --force        (backs the current ones up first)\n'
  printf 'or, to update them in place without losing your edits:\n'
  printf '  c7shell-upgrade --config-only\n'
  exit 4
fi

cat <<'MSG'

Done. Log out and pick the "c7shell" session in your display manager, or
start it from a TTY with: start-hyprland

Notes:
  - The shell is the named quickshell config "c7shell": it runs as
    `qs -c c7shell` and leaves any other ~/.config/quickshell config alone.
  - ~/.config/hypr/appearance.json is written by the settings app on first
    change; until then the defaults in conf/appearance.lua apply.
  - Executables in ~/.local/share/c7shell/scripts show up in the launcher
    under the "actions" provider.
  - Logitech thumb-button gestures expect ~/.config/solaar/rules.yaml, which
    is yours to write; the autostart entry is harmless without it.
MSG
