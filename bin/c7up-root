#!/bin/bash
# c7up-root: the only thing c7up runs as root, and the target of the
# io.crimson7.c7shell.update polkit action.
#
# pkexec hands root to a *program*, so that program is the trust boundary: it
# takes a fixed verb, never a command line. Everything else the update flow
# does -- the dry run, the AUR build, flatpak, all parsing -- stays unprivileged
# in c7up. Keep it that way: a verb that forwards arbitrary argv to a shell
# would make this a root shell for anyone in the wheel group.
set -euo pipefail

verb=${1-}
shift || true

# pkexec already sanitises the environment, but pacman reads a few of these and
# a stale value from the calling session is never what we want.
export LC_ALL=C
unset DIFFPROG PAGER EDITOR

die() { printf 'c7up-root: %s\n' "$1" >&2; exit 2; }

# A package name as pacman would accept it, plus the version comparators an
# --ignore target may carry. No slashes, no spaces, no shell metacharacters.
check_pkgname() {
  [[ $1 =~ ^[A-Za-z0-9@._+-]+$ ]] || die "refusing implausible package name: $1"
}

# A target on a pacman command line may also name the repo it comes from --
# paru resolves repo dependencies that way and sends `extra/edk2-aarch64`, which
# pacman accepts and a bare package name check does not. Exactly one repo
# segment, spelled as pacman.conf spells a section name: no dots there, so
# `./cowsay` and `extra/../etc/passwd` stay implausible names rather than paths.
check_target() {
  [[ $1 == */* ]] || { check_pkgname "$1"; return; }
  [[ $1 =~ ^[A-Za-z0-9_-]+/[A-Za-z0-9@._+-]+$ ]] \
    || die "refusing implausible package name: $1"
}

check_color() {
  [[ $1 == never || $1 == always || $1 == auto ]] || die "unexpected --color value: $1"
}

# Only files pacman itself put a .pacnew next to are resolvable. Anything else
# -- a relative path, a symlink out of /etc, a path with no .pacnew sibling --
# is a caller bug at best.
check_pacnew() {
  # Test seam, honoured only when this is NOT running as root. In production it
  # only ever runs as root -- pkexec is the sole way in -- so this branch is
  # dead code there and cannot widen what root will write to. pkexec also
  # sanitises the environment, so the variable could not survive the trip even
  # if the check were wrong.
  if ((EUID != 0)) && [[ -n ${C7UP_TEST_ROOT:-} ]]; then
    [[ $1 == "$C7UP_TEST_ROOT"/* ]] || die "not a config path: $1"
    check_canonical "$1"
    [[ -f $1.pacnew ]] || die "no pacnew beside $1"
    return 0
  fi
  [[ $1 == /etc/* || $1 == /usr/share/* || $1 == /boot/* ]] || die "not a config path: $1"
  check_canonical "$1"
  [[ -f $1.pacnew ]] || die "no pacnew beside $1"
}

# The one spelling of a path that every check below compares against. pacman
# reports canonical paths, so anything else -- /etc//sudoers, /etc/./shadow,
# a .., or a symlink -- is not a caller bug worth guessing about: it is how a
# string check like the privileged-config list is walked around.
check_canonical() {
  [[ $1 != *..* ]] || die "path traversal: $1"
  local real
  real=$(realpath -e -- "$1" 2>/dev/null) || die "not a config path: $1"
  [[ $real == "$1" ]] || die "not a canonical path: $1"
}

# A file root is about to read on the caller's behalf -- a package to install,
# a merge to write into /etc -- has to be the caller's own and not writable by
# every other user. Otherwise the polkit grant lets this caller install another
# user's planted package, or copy a file only root can read (/etc/shadow) into
# one that may be world-readable. pkexec names the caller in PKEXEC_UID; with
# no pkexec in the way (root ran this itself) there is no one else to check.
#
# The path is the caller's to change at any moment, so it is opened once and
# everything -- the checks and the read -- goes through that one descriptor.
# Checking the path and then reading it again would let the caller swap in a
# symlink to /etc/shadow in between. copy_callers_file <path> <dest> leaves the
# checked bytes in <dest>, which root owns.
copy_callers_file() {
  local fd
  exec {fd}<"$1" || die "cannot read: $1"
  if [[ -n ${PKEXEC_UID:-} ]]; then
    [[ -f /proc/self/fd/$fd ]] || die "not a regular file: $1"
    [[ $(stat -L -c %u -- "/proc/self/fd/$fd") == "$PKEXEC_UID" ]] || die "not owned by the caller: $1"
    # Other-writable only: a private group (umask 002) is the caller's own.
    [[ $(stat -L -c %A -- "/proc/self/fd/$fd") != ????????w? ]] || die "writable by others: $1"
  fi
  cat <&"$fd" > "$2"
  exec {fd}<&-
}

# Files that decide who gets root. Merging them through a GUI round trip means
# writing bytes the caller chose into them as root; take or keep the .pacnew
# here, but merge these in a terminal with sudo (and visudo).
check_not_privileged_config() {
  case $1 in
    /etc/sudoers|/etc/sudoers.d/*|/etc/shadow|/etc/gshadow|/etc/passwd|/etc/group \
    |/etc/pam.d/*|/etc/polkit-1/*)
      die "$1 decides who gets root; merge it in a terminal with sudo" ;;
  esac
}

# What a session's reply to one request ends with, and the same byte bin/c7up
# looks for. A record separator: no line of pacman output has ever contained one.
readonly mark=$'\036'

case "$verb" in
  # One authorisation for one whole run.
  #
  # pkexec authorises a *program*, and a run needs root three times, minutes
  # apart: the repo sync, the AUR helper's install of what it built, and the
  # service check at the end. As three pkexecs they were one password prompt
  # only while polkit's auth_admin_keep held, which is five minutes -- shorter
  # than most full updates, so the prompt came back mid-run. So the program
  # pkexec authorises is this loop instead: it stays alive for the run and
  # takes verbs on stdin, one per line, tab-separated between arguments.
  #
  # It is not a wider root than the verbs below, because it *is* the verbs
  # below: every request goes back through this same dispatch, by name, with
  # the same checks. Nothing here forwards a command line to a shell, and a
  # session cannot ask for a session.
  session)
    (($# == 0)) || die 'session takes no arguments'
    while IFS=$'\t' read -r -a req; do
      ((${#req[@]})) || continue
      rc=0
      if [[ ${req[0]} == session ]]; then
        printf 'c7up-root: a session cannot open a session\n' >&2
        rc=2
      else
        # stdin is the request pipe: a child that read from it would eat the
        # requests after this one. Nothing here is interactive anyway.
        "$0" "${req[@]}" </dev/null || rc=$?
      fi
      # Led by a newline of its own: a verb whose last write had none would
      # otherwise leave its final bytes sitting in front of the marker, and a
      # caller matching the start of a line would not recognise it.
      printf '\n%s%s\n' "$mark" "$rc"
    done
    exit 0
    ;;

  # Nothing, on purpose. bin/c7up asks for this first: the reply is proof that
  # the polkit dialog is behind us, which is what the wizard's "waiting for
  # authorisation" state clears on.
  ping)
    exit 0
    ;;

  # The whole repo transaction in one invocation, so the lock is taken once.
  # --noconfirm is safe *because* c7up already answered every question in the
  # wizard: the ignores below are the user's step-1 choices.
  sync)
    args=(--noconfirm --color never)
    for pkg; do check_pkgname "$pkg"; args+=(--ignore "$pkg"); done
    exec pacman -Syu "${args[@]}"
    ;;

  # What the AUR helper's --sudo shim lands on: paru builds as the user and
  # then asks its sudo command to install the built packages.
  #
  # Helpers do not agree on how to spell a pacman command line. paru sends the
  # long forms and an end-of-options marker --
  #     pacman --upgrade --color=never --noconfirm -- /path/foo.pkg.tar.zst
  # -- where yay sends `-U`. So this sorts every token into an allowed flag or
  # a target and rebuilds the command line, rather than waving a matching one
  # through: an allowlist that only knew the short spellings turned a routine
  # AUR upgrade into "unexpected pacman flag from the AUR helper: --upgrade".
  #
  # Rebuilding is also what lets --noconfirm go in front of the targets. Append
  # it to a line that already ended its options with `--` and pacman looks for
  # a package file named "--noconfirm".
  pacman)
    op=
    endopts=
    args=()
    targets=()
    while (($#)); do
      a=$1; shift
      if [[ -n $endopts ]]; then targets+=("$a"); continue; fi
      case "$a" in
        --) endopts=1 ;;

        # The three operations the helper legitimately needs: pull a repo
        # dependency, install what it built, and mark it as a dependency.
        -S|-Sy|-Su|-Syu|--sync)       op=$a; args+=("$a") ;;
        -U|--upgrade)                 op=$a; args+=("$a") ;;
        -D|--database)                op=$a; args+=("$a") ;;
        --refresh|--sysupgrade)       args+=("$a") ;;

        --asdeps|--asexplicit|--needed|--noconfirm|--noprogressbar) args+=("$a") ;;

        # Values are checked, not just the flag: --ignore takes a package name
        # and --color one of three words.
        --color=*)  check_color "${a#*=}";   args+=("$a") ;;
        --color)    check_color "${1-}";     args+=("$a" "$1"); shift ;;
        --ignore=*) check_pkgname "${a#*=}"; args+=("$a") ;;
        --ignore)   check_pkgname "${1-}";   args+=("$a" "$1"); shift ;;

        # Everything else stays out, and --root/--dbpath/--config especially:
        # each of them would let the caller point this pacman at a tree of its
        # own choosing, which is the one thing the verb exists to prevent.
        -*) die "unexpected pacman flag from the AUR helper: $a" ;;

        *) targets+=("$a") ;;
      esac
    done
    [[ -n $op ]] || die 'no pacman operation from the AUR helper'
    # Under pkexec, a built package is copied into a directory only root can
    # write, through
    # copy_callers_file, and pacman installs the copy: what was checked is
    # what gets installed. The name is kept, since pacman reads nothing from it but
    # the extension.
    pkgdir=
    for i in "${!targets[@]}"; do
      t=${targets[$i]}
      case "$t" in
        /*.pkg.tar.*)
          [[ -f $t && ! -L $t ]] || die "not a built package: $t"
          # Root ran this itself: there is no other caller to guard against.
          [[ -n ${PKEXEC_UID:-} ]] || continue
          if [[ -z $pkgdir ]]; then
            pkgdir=$(mktemp -d /var/tmp/c7up-root-XXXXXX)
            trap 'rm -rf -- "$pkgdir"' EXIT
          fi
          copy_callers_file "$t" "$pkgdir/${t##*/}"
          targets[i]=$pkgdir/${t##*/}
          ;;
        /*) die "not a built package: $t" ;;
        *) check_target "$t" ;;
      esac
    done
    # Not exec: the copies are removed once pacman is done with them.
    pacman "${args[@]}" --noconfirm -- ${targets[@]+"${targets[@]}"}
    ;;

  # Non-interactive halves of pacdiff: keep mine is just removing the .pacnew,
  # take new is installing it over the file. "merge" is not here -- it opens an
  # editor, which is a terminal's job, not root's.
  pacnew-keep)
    check_pacnew "${1-}"
    exec rm -f -- "$1.pacnew"
    ;;
  pacnew-take)
    check_pacnew "${1-}"
    # Preserve the live file's mode/owner rather than the .pacnew's: pacman
    # ships those 644 root:root even where the running config is not.
    cp --preserve=all -- "$1" "$1.c7up-bak"
    mv -f -- "$1.pacnew" "$1"
    chmod --reference="$1.c7up-bak" -- "$1"
    chown --reference="$1.c7up-bak" -- "$1"
    exec rm -f -- "$1.c7up-bak"
    ;;

  # The merge's other half. The editor runs as the user on a copy -- root must
  # never exec a program the caller names, which with auth_admin_keep would be
  # a root shell for anyone in wheel for five minutes after every update -- and
  # only the finished bytes come back here.
  #
  # This is deliberately no wider than pacnew-take: it writes to a path that
  # already has a .pacnew beside it, which is exactly the operation the user
  # authorised, and nothing else.
  pacnew-write)
    # The list matches the spelling it is given; check_pacnew then refuses any
    # spelling but the canonical one, so the two together cover every way in.
    check_not_privileged_config "${1-}"
    check_pacnew "$1"
    src=${2-}
    [[ -f $src && ! -L $src ]] || die "not a regular file: $src"
    # Built beside the live file and renamed over it, so an interruption leaves
    # the old config whole. The copy starts as the live file, which carries its
    # mode, owner, ACLs and context over, rather than whatever the user's
    # temporary copy had; only its bytes are replaced.
    new=$(mktemp -- "$1.c7up-XXXXXX")
    trap 'rm -f -- "$new"' EXIT
    cp --preserve=all -- "$1" "$new"
    copy_callers_file "$src" "$new"
    mv -f -- "$new" "$1"
    rm -f -- "$1.pacnew"
    ;;

  # The post-update task arch-update offers and the shell never showed. Root
  # re-derives the orphan list rather than trusting the argv it was handed: an
  # argument is a wish, `pacman -Qtdq` is the fact, and -Rns on a package
  # something still depends on takes that something with it.
  remove-orphans)
    (($# > 0)) || die 'no package named'
    orphans=$(pacman -Qtdq) || true
    for pkg; do
      check_pkgname "$pkg"
      grep -qxF -- "$pkg" <<<"$orphans" || die "not an orphan package: $pkg"
    done
    exec pacman -Rns --noconfirm --color never -- "$@"
    ;;

  restart-services)
    (($# > 0)) || die 'no service named'
    for s; do
      [[ $s =~ ^[A-Za-z0-9@._-]+\.service$ ]] || die "not a service unit: $s"
    done
    exec systemctl restart -- "$@"
    ;;

  # checkservices needs root to read every unit's open file handles; running it
  # here rather than under a second prompt keeps step 3 to one authorisation.
  check-services)
    exec checkservices -F -P -R \
      -i gdm.service -i plasmalogin.service -i sddm.service -i lightdm.service \
      -i lxdm.service -i slim.service -i xdm.service -i greetd.service \
      -i nodm.service -i ly.service -i lemurs.service
    ;;

  reboot)
    exec systemctl reboot
    ;;

  *)
    die "unknown verb: ${verb:-<none>}"
    ;;
esac
