#!/usr/bin/env bash
# Check that everything c7shell needs to actually run is present.
#
# The package's depends= list is only checked at install time, and half of what
# the session needs is not a package at all: the configs have to be copied into
# ~/.config, Hyprland has to be new enough to read a lua config, quickshell has
# to have been built with the QML modules the shell imports, and the machine
# needs a DRM device to open. When any of that is missing the symptom is a
# black screen and a bounce straight back to the greeter, with the reason
# buried in a log -- so check it up front instead.
set -euo pipefail
# The sddm theme parse and the drop-in body, shared with
# c7shell-bootstrap and c7shell-upgrade: share/c7shell-sddm.sh. The repo layout
# answers first, so a checkout and the test suite run the copy beside them;
# an installed script falls through to /usr/lib/c7shell. A missing lib fails
# the source and `set -e` ends the run, which is right -- c7shell-doctor
# cannot do its greeter step without it.
# Pure parameter expansion, no dirname: c7shell-doctor runs its own checks
# with PATH pointed at a fake tree, where no external command exists yet.
_c7lib=${C7SHELL_LIB:-${0%/*}/../share}
[[ -r $_c7lib/c7shell-sddm.sh ]] || _c7lib=/usr/lib/c7shell
# shellcheck source=../share/c7shell-sddm.sh
. "$_c7lib/c7shell-sddm.sh"

conf=${XDG_CONFIG_HOME:-$HOME/.config}
# Prefix for the absolute paths checked below. Empty in normal use; the test
# suite points it at a fake tree so the checks can be exercised without
# installing anything.
root=${C7SHELL_ROOT:-}
share=${C7SHELL_SHARE:-/usr/share/c7shell}
data=${XDG_DATA_HOME:-$HOME/.local/share}/c7shell
fix=0
quiet=0
pending=0
optional=0
fail=0
warned=0

usage() {
  cat <<USAGE
usage: c7shell-doctor [--fix] [--optional] [--quiet] [--setup-pending]

Checks every runtime requirement of the c7shell session and reports what is
missing. Nothing is installed or changed unless --fix is given.

  --fix     pacman -S --needed the packages behind any missing requirement
  --optional
            offer the optional packages that are not installed and let you
            pick which ones to add (needs a terminal; nothing is installed
            unless you choose it)
  --quiet   print only problems, not the things that are fine
  --setup-pending
            report an absent ~/.config copy as the next step to take rather
            than as a failure (used right after installing the package, before
            c7shell-setup has been run)

env: C7SHELL_SHARE     (default /usr/share/c7shell)
     XDG_CONFIG_HOME   (default \$HOME/.config)
     C7SHELL_ROOT      prefix for the absolute paths checked (test hook)

exit: 0 everything required is present (warnings may still be printed)
      1 something required is missing
USAGE
}

while (($#)); do
  case $1 in
    --fix) fix=1 ;;
    --quiet|-q) quiet=1 ;;
    --setup-pending) pending=1 ;;
    --optional) optional=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'c7shell-doctor: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

# Packages behind failed required checks, collected for --fix.
missing_pkgs=()

as_root() {
  if command -v sudo >/dev/null; then sudo "$@"
  elif command -v doas >/dev/null; then doas "$@"
  else
    printf 'c7shell-doctor: need root to run: %s\n' "$*" >&2
    return 1
  fi
}

# Optional packages this run found absent, offered by --optional. Declared up
# here because both the qt theming checks and the optional section fill it.
offer_pkgs=()
offer_desc=()
offer() {
  # One line per package, not per missing file: checkupdates and pacdiff both
  # come from pacman-contrib, and listing it twice under two numbers would read
  # as two separate installs.
  local p
  for p in ${offer_pkgs[@]+"${offer_pkgs[@]}"}; do [[ $p == "$1" ]] && return 0; done
  offer_pkgs+=("$1"); offer_desc+=("$2")
}

# Packages that are only useful together with another one: offered and installed
# as part of it, not as entries of their own. plasma-integration and breeze do
# nothing on a machine with no QWidget-based Qt/KDE app to theme.
declare -A companions=(
  [dolphin]='plasma-integration breeze breeze-icons'
)

# Packages pacman cannot reach, because they only exist in the AUR. The picker
# routes these to the AUR helper instead of `pacman -S`, which would fail on
# them with "target not found".
# Every AUR-only name in optional_entries below has to appear here too;
# tests/test-doctor.sh checks that the two stay in step.
declare -A aur_only=(
  [arch-update]=1
  [checkservices]=1
)
# The first helper the 'aur helper' section below finds actually running. Empty
# when there is none, or when the only one installed is broken.
aur_helper=

ok()   { ((quiet)) || printf '  ok    %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*" >&2; fail=1; }
warn() { printf '  warn  %s\n' "$*" >&2; warned=1; }
note() { printf '        %s\n' "$*" >&2; }
section() { ((quiet)) || printf '\n%s\n' "$*"; }

want_pkg() {
  local pkg=$1
  [[ -z $pkg ]] && return 0
  for p in ${missing_pkgs[@]+"${missing_pkgs[@]}"}; do
    [[ $p == "$pkg" ]] && return 0
  done
  missing_pkgs+=("$pkg")
}

# need_cmd <command> <package> <what it is for>
need_cmd() {
  if command -v "$1" >/dev/null; then
    ok "$1"
  else
    bad "$1 not found -- $3 (package: $2)"
    want_pkg "$2"
  fi
}

# opt_cmd <command> <package> <what it is for>
opt_cmd() {
  if command -v "$1" >/dev/null; then
    ok "$1 (optional)"
  else
    warn "$1 not found -- $3 (package: $2, optional)"
  fi
}

# need_file <path> <package> <what it is for>
need_file() {
  if [[ -e $root$1 ]]; then
    ok "$1"
  else
    bad "$1 missing -- $3 (package: $2)"
    want_pkg "$2"
  fi
}

qml_roots() {
  local dir
  for dir in "$root"/usr/lib/qt6/qml "$root"/usr/lib64/qt6/qml "$root"/usr/lib/qt/qml; do
    [[ -d $dir ]] && printf '%s\n' "$dir"
  done
}

# need_qml <Dotted.Module> <package> <what it is for>
# A module is its qmldir: a directory without one loads nothing.
need_qml() {
  local path=${1//.//} dir
  while read -r dir; do
    [[ -f $dir/$path/qmldir ]] && { ok "QML $1"; return; }
  done < <(qml_roots)
  bad "QML module $1 not available -- $3 (package: $2)"
  want_pkg "$2"
}

# need_py <import> <package> <what it is for>
need_py() {
  if python3 -c "import $1" 2>/dev/null; then
    ok "python: $1"
  else
    bad "python module $1 not importable -- $3 (package: $2)"
    want_pkg "$2"
  fi
}

section 'compositor'
need_cmd Hyprland hyprland 'the compositor itself'
# The session entry execs start-hyprland, not Hyprland: it is the launcher
# Hyprland has expected since 0.53 (it exports the session and portal
# environment and adds crash recovery), and Hyprland warns on screen when it
# is bypassed. Shipped by the same package, so a missing one means it is old.
need_cmd start-hyprland hyprland 'the launcher the c7shell session entry execs'
need_cmd hyprctl  hyprland 'dispatching to the compositor from the shell'

# The config is hyprland.lua, and lua config landed in Hyprland 0.56. An older
# Hyprland silently ignores it, writes a default hyprland.conf and comes up as
# a bare compositor -- or refuses the session outright.
if command -v Hyprland >/dev/null; then
  ver=$(Hyprland --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true)
  if [[ -z $ver ]]; then
    warn "could not read the Hyprland version; this config needs 0.56 or newer (lua config)"
  else
    IFS=. read -r maj min _ <<<"$ver"
    if ((maj > 0 || min >= 56)); then
      ok "Hyprland $ver (>= 0.56, reads hyprland.lua)"
    else
      bad "Hyprland $ver is too old: hypr/hyprland.lua needs 0.56 or newer"
      want_pkg hyprland
    fi
  fi
fi

section 'shell'
need_cmd qs quickshell 'the shell itself (qs -c c7shell)'
need_cmd c7shell-session c7shell 'keeps the shell running; hypr autostarts it'
# Quickshell modules are compile-time options; a build without them starts and
# then throws on the import, which takes the whole shell down.
need_qml Quickshell                       quickshell 'the shell core'
need_qml Quickshell.Hyprland              quickshell 'workspaces and window state in the bar'
need_qml Quickshell.Io                    quickshell 'IPC handlers behind every qs ipc call bind'
need_qml Quickshell.Wayland               quickshell 'layer-shell surfaces (bar, launcher, OSDs)'
need_qml Quickshell.Bluetooth             quickshell 'the bluetooth applet'
need_qml Quickshell.Networking            quickshell 'the network applet'
need_qml Quickshell.Services.Pipewire     quickshell 'volume control and the audio OSD'
need_qml Quickshell.Services.UPower       quickshell 'the battery indicator'
need_qml Quickshell.Services.SystemTray   quickshell 'the system tray'
need_qml Quickshell.Services.Notifications quickshell 'the notification daemon'
need_qml Quickshell.Services.Mpris        quickshell 'the media pill, its tray popover and the track-change OSD'
need_qml QtQuick.Effects qt6-declarative 'shadows and blur across the shell'
need_qml QtQuick.Shapes  qt6-declarative 'the ring and arc indicators'
# The shell's own C++ plugin (plugin/), installed by this package.
need_qml C7 c7shell 'the C7 plugin the shell binds its system state to'

section 'session helpers'
need_cmd hypridle  hypridle  'idle timeouts, autostarted'
need_cmd hyprlock  hyprlock  'the lock screen (SUPER+L, hypridle)'
need_cmd hyprpaper hyprpaper 'the wallpaper, autostarted'
need_cmd hyprpicker hyprpicker 'the colour picker in the settings app'
need_file /usr/share/polkit-1/actions/io.crimson7.c7shell.policy c7shell \
  'the update flow'"'"'s polkit action -- without it applying updates from the bar cannot elevate'
need_file /usr/lib/c7shell/c7up-root c7shell \
  'the root half of the update flow, reached only through that polkit action'
need_file /usr/lib/hyprpolkitagent/hyprpolkitagent hyprpolkitagent \
  'the fallback polkit agent, launched only if c7-authd will not start'
# The password prompt. c7-authd registers as the session's polkit agent and
# serves the socket c7-askpass connects to; without it nothing in the session
# can be authorised through the shell, and pkexec has no agent to talk to at
# all now that conf/autostart.lua no longer starts hyprpolkitagent.
need_cmd c7-authd   c7shell 'the password prompt'"'"'s backend (polkit agent + sudo askpass)'
need_cmd c7-askpass c7shell 'what SUDO_ASKPASS points at, so sudo -A prompts through the shell'
need_cmd grim        grim         'screenshots'
need_cmd wf-recorder wf-recorder  'screen recording'
need_cmd wl-copy     wl-clipboard 'copying captures to the clipboard'
# The delayed screenshot's second half. Its shutter fires before the rectangle
# is drawn -- that is the point of it, since the hover menu you are capturing
# is gone the moment you move the pointer to draw -- so the region is cut out
# of the captured frame afterwards, by scripts/c7shell-crop.py through
# gdk-pixbuf. grim reads the compositor and cannot re-crop a file.
#
# Checked as a typelib import rather than a command: nothing here is on PATH,
# and gdk-pixbuf2 arrives transitively through gtk3 on most machines, which is
# exactly why its absence would otherwise surface as one broken chip rather
# than as a missing package.
if python3 -c 'import gi; gi.require_version("GdkPixbuf", "2.0"); from gi.repository import GdkPixbuf' 2>/dev/null; then
  ok 'gdk-pixbuf (delayed screenshot crop)'
else
  bad 'the GdkPixbuf typelib is missing -- the delayed screenshot cannot crop its frame (package: gdk-pixbuf2)'
  want_pkg gdk-pixbuf2
fi
need_cmd notify-send libnotify    'notifications from the shell scripts'
need_cmd wpctl       wireplumber  'the volume and mute keybinds'
need_cmd bluetoothctl bluez-utils 'the bluetooth applet'
need_cmd nmcli       networkmanager 'the network applet'

# Airplane mode is thrown through rfkill: the binary is in util-linux, which
# every Arch install has, but the device needs write access -- logind grants
# that to the active seat by ACL (70-uaccess.rules), so a bad answer here is
# not a missing package. No device at all means no radios: nothing to report.
if [[ -e $root/dev/rfkill ]]; then
  if [[ -w $root/dev/rfkill ]]; then
    ok '/dev/rfkill writable (airplane mode)'
  else
    warn "/dev/rfkill is not writable -- airplane mode will fail. Fix: sudo gpasswd -a $(id -un) rfkill, then log out and back in (c7shell-bootstrap does this)"
  fi
fi
need_cmd systemctl   systemd      'the power menu (suspend, reboot, poweroff)'

# Only checked when a QWidget-based Qt/KDE app is actually installed. The shell
# is QML and takes none of this; on a machine with no such apps the platform
# theme has nothing to theme, and warning about it would be noise.
kde_apps=()
for app in dolphin kate kwrite gwenview okular ark kcalc konsole systemsettings; do
  command -v "$app" >/dev/null && kde_apps+=("$app")
done

if ((${#kde_apps[@]})); then
section 'qt app theming'
# conf/environment.lua sets QT_QPA_PLATFORMTHEME=kde and the settings app
# exports the palette to kdeglobals. Both are inert without the plugin that
# implements that platform theme -- the symptom is a correctly themed shell
# next to a stock-looking dolphin.
info_apps=${kde_apps[*]}
((quiet)) || printf '  ok    Qt/KDE apps present: %s\n' "$info_apps"
qt_plugin() {
  local rel=$1 pkg=$2 what=$3 dir
  while read -r dir; do
    [[ -e ${dir%/qml}/plugins/$rel ]] && { ok "qt plugin $rel"; return; }
  done < <(qml_roots)
  warn "qt plugin $rel missing -- $what (package: $pkg)"
  offer "$pkg" "$what"
}
qt_plugin platformthemes/KDEPlasmaPlatformTheme6.so plasma-integration \
  'QT_QPA_PLATFORMTHEME=kde does nothing without it: KDE apps ignore the c7shell palette'
qt_plugin styles/breeze6.so breeze \
  'the widget style that platform theme draws with'
if [[ -f $conf/kdeglobals ]] && grep -q '^ColorScheme=C7Shell' "$conf/kdeglobals"; then
  ok "$conf/kdeglobals exports the C7Shell scheme"
elif [[ -f $conf/quickshell/c7shell/scripts/c7shell-theme-export.py ]]; then
  warn "$conf/kdeglobals has no C7Shell scheme yet, so Qt apps use their own colours"
  note 'seed it:  python3 ~/.config/quickshell/c7shell/scripts/c7shell-theme-export.py'
fi
fi

section 'lock screen'
# hyprlock refuses to start without a config: "Could not find config. Searched
# in order: XDG_CONFIG_HOME, HOME, XDG_CONFIG_DIRS, /etc/xdg". The copy the
# hyprlock package leaves in /usr/share/hypr is not in that list, so it is never
# found. From the desk this looks like SUPER+L doing nothing -- and, the part
# nobody notices, hypridle's lock_cmd and before_sleep_cmd failing silently, so
# the machine idles and suspends unlocked. A failure, not a warning: the session
# ships a lock keybind, a lock row in the power menu and a 5-minute idle lock,
# and all three are dead without this file.
# Skipped entirely when ~/.config/hypr is not there yet: that is the "configs
# were never copied" case, which the user config section below reports once, and
# a second failure for a file inside the tree that is missing adds nothing.
if command -v hyprlock >/dev/null && [[ -d $conf/hypr ]]; then
  lock_conf=''
  for candidate in "$conf/hypr/hyprlock.conf" \
                   "$root/etc/xdg/hypr/hyprlock.conf"; do
    [[ -f $candidate ]] && { lock_conf=$candidate; break; }
  done
  if [[ -n $lock_conf ]]; then
    ok "${lock_conf/#$HOME/~}"
    # A grace period on a before-sleep lock unlocks the screen on resume, and
    # `grace` is not even a config key in hyprlock 0.9 -- it is a CLI flag, so
    # writing it here is a config error that stops hyprlock starting at all.
    if grep -qE '^[[:space:]]*grace[[:space:]]*=' "$lock_conf"; then
      warn "$lock_conf sets grace, which is a CLI flag in hyprlock 0.9, not a"
      note 'config key: hyprlock reports a config error and refuses to start.'
    fi
    # A newer hyprlock.conf parked beside an edited one. c7shell-upgrade says
    # this once, at the moment it writes the file, and then never again -- so on
    # the machine that most needs to hear it (an install whose config predates
    # the manifest, where *everything* is treated as edited) the message is long
    # gone and the lock screen quietly stays on the old design. This is the only
    # thing that still knows.
    if [[ -f $lock_conf.new ]]; then
      warn 'a newer hyprlock.conf is waiting beside yours as hyprlock.conf.new --'
      note 'c7shell-upgrade kept your copy because it differs from what was'
      note 'installed. Merge the two and the new lock screen takes effect at the'
      note 'next lock; nothing needs restarting.'
      note "  diff ${lock_conf/#$HOME/~} ${lock_conf/#$HOME/~}.new"
    fi
    # The now-playing and status lines are a command on PATH, not a path in the
    # config: refreshing ~/.config alone (c7shell-upgrade --config-only) leaves
    # the config asking for a binary the old package never installed. The labels
    # fail silently, so nothing else would ever mention it.
    if grep -q 'c7shell-lock-info' "$lock_conf" && ! command -v c7shell-lock-info >/dev/null; then
      warn 'hyprlock.conf calls c7shell-lock-info, which is not installed --'
      note 'the now-playing and status lines will be blank. It ships with the'
      note 'package, so the config was refreshed without it: c7shell-upgrade'
    fi
    # The accent. hyprlang has no variable expansion and cannot read JSON, so
    # the lock screen follows appearance.json only through the file the export
    # script writes and hyprlock.conf sources. Missing means a picked accent
    # stops at the lock screen -- crimson, and nothing says why.
    if grep -q 'hyprlock-palette.conf' "$lock_conf" \
       && [[ ! -f $conf/hypr/hyprlock-palette.conf ]]; then
      warn 'the lock screen has no exported palette, so it keeps the default'
      note 'crimson whatever accent is picked in the settings app.'
      note 'seed it:  python3 ~/.config/quickshell/c7shell/scripts/c7shell-theme-export.py'
    fi
    # SUPER+L, the power menu's lock row and hypridle all run c7shell-lock now.
    # It ships with the package while the keybind ships with the config, so a
    # ~/.config refreshed without a package rebuild (c7shell-upgrade
    # --config-only) leaves every one of them calling a command that is not
    # there. Nothing locks, and -- as ever -- the before-sleep lock fails the
    # same way, so the machine suspends unlocked. A failure, not a warning.
    if [[ -f $conf/hypr/conf/binds.lua ]] \
       && grep -q 'c7shell-lock"' "$conf/hypr/conf/binds.lua" \
       && ! command -v c7shell-lock >/dev/null; then
      bad 'the lock keybind runs c7shell-lock, which is not installed -- nothing'
      note 'locks, and this machine suspends unlocked. It ships with the package,'
      note 'so the config was refreshed without rebuilding it:'
      note '  c7shell-upgrade'
    fi
  elif ((pending)); then
    printf '  next  the lock screen config lands with the rest -- run: c7shell-setup\n'
  else
    bad 'hyprlock has no config, so SUPER+L, the power menu lock row and the'
    note "5-minute idle lock all do nothing -- and hypridle's before_sleep_cmd"
    note 'fails too, which means this machine suspends unlocked.'
    note "hyprlock only searches XDG_CONFIG_HOME, HOME, XDG_CONFIG_DIRS and"
    note "/etc/xdg; the copy in /usr/share/hypr is never found."
    if [[ -f $share/hypr/hyprlock.conf ]]; then
      note 'the config ships with c7shell -- run: c7shell-upgrade   (adds it as a new file)'
    else
      note 'update the package first: c7shell-upgrade'
    fi
  fi
fi

section 'appmenu daemon'
need_cmd python3 python 'the global menu daemon, autostarted first'
need_py dbus python-dbus 'the daemon owns com.canonical.AppMenu.Registrar on the bus'
need_py gi   python-gobject 'the daemon glib main loop'

section 'portal'
# Without the portal, screen sharing silently offers no sources.
if compgen -G "$root/usr/lib*/xdg-desktop-portal-hyprland" >/dev/null \
   || compgen -G "$root/usr/libexec/xdg-desktop-portal-hyprland" >/dev/null; then
  ok 'xdg-desktop-portal-hyprland'
else
  bad 'xdg-desktop-portal-hyprland missing -- screen sharing (package: xdg-desktop-portal-hyprland)'
  want_pkg xdg-desktop-portal-hyprland
fi

# The Settings interface is the one an app asks "does this desktop prefer dark?"
# through. xdph does not implement it, so without a second backend every such
# app answers itself with light. The gtk backend does implement it, and
# /usr/share/xdg-desktop-portal/hyprland-portals.conf already names gtk as the
# fallback -- installing it is the whole fix.
if compgen -G "$root/usr/lib*/xdg-desktop-portal-gtk" >/dev/null \
   || compgen -G "$root/usr/libexec/xdg-desktop-portal-gtk" >/dev/null; then
  ok 'xdg-desktop-portal-gtk'
else
  bad 'xdg-desktop-portal-gtk missing -- apps that detect a system theme all pick light (package: xdg-desktop-portal-gtk)'
  want_pkg xdg-desktop-portal-gtk
fi

# The shipped hyprland-portals.conf routes FileChooser to the kde backend: the
# KDE file dialog shares dolphin's KIO sidebar and kdeglobals palette, so the
# picker matches the file manager. A warn, not a FAIL -- without it the portal
# falls back to the gtk picker on its own and nothing stops working.
if compgen -G "$root/usr/lib*/xdg-desktop-portal-kde" >/dev/null \
   || compgen -G "$root/usr/libexec/xdg-desktop-portal-kde" >/dev/null; then
  ok 'xdg-desktop-portal-kde'
else
  warn 'xdg-desktop-portal-kde missing -- file pickers fall back to the gtk one, which matches nothing (package: xdg-desktop-portal-kde)'
fi

# The portal reads hyprland-portals.conf once, when it starts. A copy written
# after that -- by c7shell-setup, or by an upgrade -- is not in force: the
# routing above keeps answering out of whatever the file said at boot, so
# FileChooser quietly stays on the gtk backend and every picker on the machine,
# the settings app's wallpaper browse included, is the one that matches nothing.
# Nothing else reports this; the config is correct on disk and the desktop looks
# fine, which is exactly why it is worth a line here.
portals=$conf/xdg-desktop-portal/hyprland-portals.conf
if [[ -f $portals ]] && command -v systemctl >/dev/null \
   && command -v date >/dev/null && command -v stat >/dev/null; then
  started=$(systemctl --user show xdg-desktop-portal.service \
              -p ActiveEnterTimestamp --value 2>/dev/null || true)
  # Empty on a machine where the portal has never run, and the socket starts it
  # on demand -- neither is something to report.
  if [[ -n $started ]]; then
    started_at=$(date -d "$started" +%s 2>/dev/null || true)
    written_at=$(stat -c %Y "$portals" 2>/dev/null || true)
    if [[ -n $started_at && -n $written_at ]] && ((written_at > started_at)); then
      warn 'xdg-desktop-portal started before the portal config was written, so the'
      note 'FileChooser routing is not in force yet and pickers still come from gtk'
      note 'systemctl --user restart xdg-desktop-portal'
    else
      ok 'the running portal is newer than its config'
    fi
  fi
fi

# ...and the backend can only report what GSettings holds. Unset means "no
# preference", which is what left every app light in the first place.
if command -v gsettings >/dev/null; then
  scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)
  case $scheme in
    *prefer-dark*|*prefer-light*) ok "color-scheme preference exported (${scheme//\'/})" ;;
    '') warn 'gsettings cannot read org.gnome.desktop.interface (package: gsettings-desktop-schemas)' ;;
    *)
      warn 'no color-scheme preference set, so apps that detect one pick light'
      note 'it follows the theme in the settings app (Appearance); export it:'
      note 'python3 ~/.config/quickshell/c7shell/scripts/c7shell-theme-export.py'
      ;;
  esac
fi

section 'session entry'
need_file /usr/share/wayland-sessions/c7shell.desktop c7shell \
  'the "c7shell" entry your greeter lists'

# An install from before the launcher fix still has Exec=Hyprland here, which
# makes Hyprland warn at every login that it was started without
# start-hyprland. The file is package-owned, so the fix is a package rebuild.
entry=$root/usr/share/wayland-sessions/c7shell.desktop
if [[ -f $entry ]]; then
  exec_line=$(grep -m1 '^Exec=' "$entry" || true)
  case $exec_line in
    'Exec=start-hyprland') ok 'session entry execs start-hyprland' ;;
    'Exec=Hyprland')
      warn 'the installed session entry execs Hyprland directly, so Hyprland warns'
      note 'at login that it "was started without start-hyprland". Rebuild the'
      note 'package to fix it:  c7shell-upgrade'
      ;;
    *) warn "unexpected launcher in $entry: ${exec_line:-none}" ;;
  esac
fi

section 'greeter'
# The greeter is where a broken session shows up, and where the theme is easiest
# to get half-installed: the QML ships with the package, the selection is a line
# in /etc/sddm.conf.d that only c7shell-bootstrap or c7shell-upgrade writes. All
# warnings, never failures -- a machine may deliberately run another display
# manager, and the session works either way.

sddm_theme=$root/usr/share/sddm/themes/c7shell
if [[ -d $sddm_theme ]]; then
  ok '/usr/share/sddm/themes/c7shell'
  current=$(sddm_theme_current "$root")
  case $current in
    c7shell) ok 'sddm uses the c7shell greeter theme' ;;
    '')
      warn 'no sddm theme is selected, so the greeter comes up unstyled'
      note 'select it:  c7shell-upgrade   (or c7shell-bootstrap on a fresh machine)'
      ;;
    *)
      warn "sddm is set to the \"$current\" theme, not c7shell"
      note 'that may well be deliberate; to switch, run: c7shell-bootstrap'
      ;;
  esac
  # Which greeter binary sddm will launch for this theme, and whether it can
  # actually run. sddm builds the path as sddm-greeter + (QtVersion ? "-qt<n>" :
  # ""), so a theme that declares nothing is handed to the Qt5 greeter -- which
  # Arch ships, but whose Qt5 libraries are only an optdepend of sddm. It exits
  # 127 and the login screen is black, with the reason only in sddm's journal.
  # Nothing else on this machine notices until the next reboot, which is why
  # this is checked here rather than left to the theme.
  if [[ $current == c7shell ]]; then
    # Parsed in bash: this file's checks run under a PATH with almost nothing
    # on it, and the rest of the doctor sticks to grep and head for the same
    # reason.
    qt_version=''
    while IFS= read -r line; do
      [[ $line =~ ^QtVersion=([0-9]+)[[:space:]]*$ ]] && qt_version=${BASH_REMATCH[1]}
    done < "$sddm_theme/metadata.desktop" 2>/dev/null || true
    greeter_bin=$root/usr/bin/sddm-greeter${qt_version:+-qt$qt_version}
    if [[ ! -x $greeter_bin ]]; then
      bad "the theme asks sddm for ${greeter_bin##*/}, which is not installed -- the greeter would be a black screen"
      want_pkg sddm
    elif ! command -v ldd >/dev/null; then
      ok "greeter binary ${greeter_bin##*/} is installed"
    elif missing_libs=$(ldd "$greeter_bin" 2>/dev/null | grep 'not found'); then
      bad "${greeter_bin##*/} cannot start: ${missing_libs%%$'\n'*}"
      note 'sddm picks that binary from QtVersion in the theme metadata; the'
      note 'greeter exits 127 and the login screen is black.'
      [[ -z $qt_version ]] && note 'the theme declares no QtVersion, so sddm defaulted to the Qt5 greeter'
    else
      ok "greeter binary ${greeter_bin##*/} runs"
    fi
  fi

  # The network pill's only source of truth. Nothing breaks without it -- the
  # pill just never appears -- but "my greeter shows no wifi" has no other
  # explanation, and a dispatcher script is easy to lose to a manual /usr edit.
  if [[ $current == c7shell ]] && command -v nmcli >/dev/null; then
    dispatcher=''
    for d in "$root"/usr/lib/NetworkManager/dispatcher.d "$root"/etc/NetworkManager/dispatcher.d; do
      [[ -x $d/50-c7shell-greeter ]] && dispatcher=$d/50-c7shell-greeter
    done
    if [[ -n $dispatcher ]]; then
      ok "greeter network readout (${dispatcher#"$root"})"
    else
      warn 'the greeter shows no network: 50-c7shell-greeter is not in'
      note 'NetworkManager'"'"'s dispatcher.d, so nothing publishes the connection'
      note 'where the greeter (running as the sddm user, with no D-Bus) can read it.'
      note 'It ships with the package, so a rebuild restores it: c7shell-upgrade'
    fi
  fi

  # Without this the greeter still comes up, but its top-left line loses the
  # kernel version and the bottom bar loses the battery: QML refuses file://
  # reads unless the greeter's environment allows them.
  if [[ $current == c7shell ]]; then
    if grep -rqs 'QML_XHR_ALLOW_FILE_READ' "$root"/etc/sddm.conf "$root"/etc/sddm.conf.d/; then
      ok 'the greeter may read /proc and /sys (kernel and battery readout)'
    else
      warn 'GreeterEnvironment does not set QML_XHR_ALLOW_FILE_READ=1, so the'
      note 'greeter shows no kernel version and no battery level'
      note 'fix it:  c7shell-upgrade   (it rewrites the sddm drop-in)'
    fi
  fi
elif command -v sddm-greeter-qt6 >/dev/null || command -v sddm >/dev/null; then
  warn 'sddm is installed but /usr/share/sddm/themes/c7shell is not -- the'
  note 'greeter theme ships with the package, so rebuild it: c7shell-upgrade'
else
  warn 'sddm is not installed, so the c7shell greeter theme is unused'
  note 'install it:  c7shell-bootstrap'
fi

section 'user config'
# This is the one that produces the classic "black screen, back to the
# greeter": the package deliberately installs to /usr/share, and neither
# hyprland nor quickshell reads config from there.
for rel in hypr/hyprland.lua quickshell/c7shell/shell.qml; do
  if [[ -f $conf/$rel ]]; then
    ok "$conf/$rel"
  elif ((pending)); then
    printf '  next  %s is not there yet -- run: c7shell-setup\n' "$conf/$rel"
  else
    bad "$conf/$rel missing -- the configs were never copied out of $share"
    note "run: c7shell-setup      (as your own user, not root)"
  fi
done
# The half-upgraded machine, and the reason it is worth its own check: the
# package half of c7shell-upgrade and the config half can land separately. If
# you had edited shell.qml, the refresh leaves yours alone and parks the new one
# beside it -- so the package brings c7-authd while your shell.qml has no
# AuthWindow in it. The shell then registers as the polkit agent and draws no
# prompt for it, which is worse than not being the agent at all: pkexec waits
# on a window that does not exist.
shellqml=$conf/quickshell/c7shell/shell.qml
if command -v c7-authd >/dev/null && [[ -f $shellqml ]] \
   && ! grep -q 'AuthWindow' "$shellqml"; then
  bad "$shellqml has no AuthWindow, but this machine has the password prompt's
       backend installed -- so nothing would draw the prompt it raises"
  note "your config is older than the package. run: c7shell-upgrade --config-only"
  note "if that reports a conflict on shell.qml, merge it:  diff -u $shellqml{,.new}"
fi

# The other half of the same split, and only a note: this one is not broken,
# just not switched over. Two agents cannot both hold the registration, so
# whichever starts first draws every prompt.
autostart=$conf/hypr/conf/autostart.lua
if command -v c7-authd >/dev/null && [[ -f $autostart ]] \
   && grep -q 'hyprpolkitagent' "$autostart"; then
  note "$autostart still starts hyprpolkitagent, so it will keep drawing the"
  note 'password prompts. c7shell-upgrade --config-only replaces that file.'
fi

# The launcher's "actions" provider scans this one directory and shows nothing
# at all when it is missing, so a user who put a script somewhere else gets no
# error to explain the empty result. c7shell-setup creates it; a machine set up
# before that just needs the mkdir.
if [[ -d $data/scripts ]]; then
  ok "$data/scripts   (launcher \"actions\" scripts)"
else
  note "$data/scripts does not exist, so the launcher's \"actions\" provider"
  note 'lists no user scripts. create it:  mkdir -p '"$data/scripts"
fi

if [[ -d $share ]]; then
  ok "$share"
else
  warn "$share missing -- the c7shell package does not look installed"
fi

section 'hardware'
# A session that cannot open a DRM device dies immediately at startup, which
# looks exactly like a config error from the greeter's side.
if compgen -G "$root/dev/dri/card*" >/dev/null; then
  ok "$(echo "$root"/dev/dri/card*)"
else
  bad '/dev/dri/card* missing -- no GPU driver is loaded, the compositor cannot start'
  note 'check: lspci -k | grep -A3 -E "VGA|3D"   and install the matching driver'
fi
if [[ -e $root/dev/dri/renderD128 ]]; then
  ok '/dev/dri/renderD128'
else
  warn '/dev/dri/renderD128 missing -- no render node, expect software rendering at best'
fi

# A virtual GPU can advertise 3D and still hand Qt a context it cannot render
# into. On VMware's vmwgfx that is confirmed fatal: aquamarine walks its EGL
# context down until Hyprland itself comes up, but quickshell renders nothing
# into the context it is given, attaches an invalid buffer -- "invalid
# arguments for wl_surface.attach" -- and dies, taking the bar, the launcher
# and every popup with it. What is left is a cursor on an empty screen, which
# looks exactly like a config error and passes every other check in here,
# because nothing is missing.
#
# conf/environment.lua answers this by pointing clients at llvmpipe. That file
# lives in the user's ~/.config copy, and no package upgrade rewrites those --
# an install made before the fix landed keeps the old copy and keeps failing.
# So check the copy that is actually read, not the one under $share.
# Parsed with the shell's own read rather than sed or grep: this runs before
# anything has verified the PATH, and a doctor that dies on a missing tool is
# worse than useless.
virtual_gpu=
for uevent in "$root"/sys/class/drm/card*/device/uevent; do
  [[ -r $uevent ]] || continue
  while IFS= read -r line; do
    case $line in
      DRIVER=vmwgfx|DRIVER=vboxvideo|DRIVER=virtio_gpu)
        virtual_gpu=${line#DRIVER=}; break 2 ;;
    esac
  done < "$uevent"
done

if [[ -n $virtual_gpu ]]; then
  env_lua=$conf/hypr/conf/environment.lua
  if [[ ! -f $env_lua ]]; then
    # No ~/.config copy at all; the "user config" section already reported it.
    :
  elif grep -q LIBGL_ALWAYS_SOFTWARE "$env_lua"; then
    ok "$virtual_gpu: environment.lua falls back to llvmpipe"
  else
    # vmwgfx is the one reproduced end to end, so it is a failure there and a
    # warning on the others -- vboxvideo and virtio_gpu are pre-empted by the
    # same fallback, but a working session on them is not out of the question
    # and this should not fail a machine that is fine.
    if [[ $virtual_gpu == vmwgfx ]]; then
      bad "$virtual_gpu: environment.lua has no llvmpipe fallback -- quickshell will die at startup and the session comes up empty"
    else
      warn "$virtual_gpu: environment.lua has no llvmpipe fallback -- if the session comes up empty, this is why"
    fi
    if [[ -f $env_lua.new ]] && grep -q LIBGL_ALWAYS_SOFTWARE "$env_lua.new"; then
      note "the new version is already waiting in conf/environment.lua.new --"
      note "merge it into conf/environment.lua and log back in"
    else
      note 'your ~/.config copy predates the fix. To take the new version:'
      note '  c7shell-upgrade --config-only'
      note 'if that reports environment.lua kept, merge the conf/environment.lua.new'
      note 'it writes beside it, then log back in'
    fi
  fi

  # The second thing a virtual GPU breaks, and the one nothing else notices.
  # hyprlock takes a copy of the screen at startup -- for the screenshot
  # background and for the fade, which is on by default -- and its default route
  # is a GBM buffer over zwp_linux_dmabuf_v1. aquamarine cannot build a DRM
  # renderer on a virtual GPU, so the compositor rejects the buffer and kills the
  # connection; hyprlock aborts before drawing anything. SUPER+L does nothing,
  # the power menu's lock row does nothing, and hypridle's before_sleep_cmd fails
  # the same way, so the machine suspends unlocked. general:screencopy_mode = 1
  # is the shm route, which is the one grim uses and the one that works here.
  lock_conf=$conf/hypr/hyprlock.conf
  if [[ ! -f $lock_conf ]]; then
    # Reported by the lock screen section above; nothing to add.
    :
  elif grep -qE '^[[:space:]]*screencopy_mode[[:space:]]*=[[:space:]]*1' "$lock_conf"; then
    ok "$virtual_gpu: hyprlock.conf takes the screen copy through shm"
  else
    if [[ $virtual_gpu == vmwgfx ]]; then
      bad "$virtual_gpu: hyprlock.conf has no screencopy_mode = 1 -- hyprlock aborts on the dmabuf copy, so nothing locks and the machine suspends unlocked"
    else
      warn "$virtual_gpu: hyprlock.conf has no screencopy_mode = 1 -- if SUPER+L does nothing, this is why"
    fi
    if [[ -f $lock_conf.new ]] && grep -qE '^[[:space:]]*screencopy_mode[[:space:]]*=[[:space:]]*1' "$lock_conf.new"; then
      note 'the new version is already waiting in hyprlock.conf.new --'
      note 'merge it into hyprlock.conf; the next lock picks it up'
    else
      note 'your ~/.config copy predates the fix. To take the new version:'
      note '  c7shell-upgrade --config-only'
      note 'if that reports hyprlock.conf kept, merge the hyprlock.conf.new it'
      note 'writes beside it'
    fi
  fi

  # The third thing it breaks. hyprpaper draws through hyprtoolkit, which has no
  # software path: it commits a dmabuf for every wallpaper, aquamarine cannot
  # import it for want of that same DRM renderer, and the compositor drops the
  # connection -- hyprtoolkit then aborts rather than exiting. So hyprpaper is
  # not merely wallpaper-less on these machines, it SIGABRTs on the first
  # request of the session and is gone. Nothing reports that: the setting is
  # saved, the picker works, and the desktop simply never changes.
  #
  # conf/gpu.lua leaves hyprpaper out of autostart here and has the shell paint
  # the wallpaper instead. Same reasoning as the hyprlock check above -- the
  # ~/.config copy is the one that runs, and no package upgrade rewrites it.
  gpu_conf=$conf/hypr/conf/gpu.lua
  if [[ -f $gpu_conf ]]; then
    ok "$virtual_gpu: the shell paints the wallpaper (hyprpaper cannot here)"
  else
    warn "$virtual_gpu: hyprpaper is autostarted, and it aborts on the first wallpaper -- the wallpaper setting does nothing"
    note 'your ~/.config copy predates the fix. To take the new version:'
    note '  c7shell-upgrade --config-only'
  fi
fi

section 'aur helper'
# An AUR helper links libalpm, but the AUR packages only declare
# `libalpm.so>=14` -- so pacman happily keeps one installed across a soname
# bump (pacman 7.0 shipped libalpm.so.15, 7.1 ships .16) that the binary
# cannot survive. Nothing in c7shell needs a helper at runtime, but a dead one
# silently blocks every later AUR update, and the failure names a missing
# library rather than the upgrade that caused it.
for helper in paru yay; do
  command -v "$helper" >/dev/null || continue
  if err=$("$helper" --version 2>&1 >/dev/null); then
    ok "$helper runs"
    # What --optional installs the AUR entries with. A broken helper is no
    # helper, so this is only ever set from the branch that just ran one.
    if [[ -z $aur_helper ]]; then aur_helper=$helper; fi
  elif [[ $err == *libalpm.so* ]]; then
    warn "$helper is broken: ${err%%$'\n'*}"
    note "pacman's libalpm changed soname under it. Rebuild the *source*"
    note "package -- a -bin package just unpacks the same prebuilt binary:"
    note "  git clone https://aur.archlinux.org/$helper.git"
    note "  cd $helper && makepkg -si"
  else
    warn "$helper does not run: ${err%%$'\n'*}"
  fi
done

section 'optional programs'
# One table, used twice: to report what is absent, and to offer it under
# --optional. kind is `cmd` (found on PATH) or `file` (an absolute path, since
# the config calls it by one).
optional_entries=(
  "cmd:kitty:kitty:the terminal bound to SUPER+Q"
  "cmd:dolphin:dolphin:the file manager bound to SUPER+E"
  "cmd:hyprlauncher:hyprlauncher:fallback launcher (the shell has its own)"
  "cmd:ddcutil:ddcutil:brightness on external monitors"
  "cmd:brightnessctl:brightnessctl:brightness on internal panels"
  "cmd:upower:upower:battery readout in the bar"
  "cmd:playerctl:playerctl:the media keybinds"
  "cmd:solaar:solaar:Logitech thumb-button gestures, autostarted if present"
  "cmd:jq:jq:helper scripting"
  "file:/usr/lib/pam_kwallet_init:kwallet:secret storage unlocked at login, or kwallet prompts"
  # AUR, not a repo package: it is installed through aur_only above, and the
  # PKGBUILD lists it in optdepends= for the same reason. New entries go at the
  # end -- tests/test-doctor.sh picks packages out of this list by number.
  "cmd:arch-update:arch-update:shared config and state for the update flow (AUR)"
  # The update flow's own dependencies. checkupdates is what makes the dry run
  # rootless (it syncs into a temporary database), and pacdiff is the pacnew
  # list step 3 is built from -- without pacman-contrib the badge can count
  # nothing and the wizard has no step 3.
  "cmd:checkupdates:pacman-contrib:the rootless update check the bar's badge is built on"
  "cmd:pacdiff:pacman-contrib:the pacnew list the update wizard reviews"
  "cmd:checkservices:checkservices:the post-update service restart check"
  # c7up degrades to more, then to cat, so this really is optional -- but the
  # update log and PKGBUILD diffs are much easier to read in a real pager.
  "cmd:less:less:a scrolling pager for the update log and PKGBUILD diffs"
  # The third source the update flow knows about. With it installed, flatpak
  # updates are counted and applied in the same run as the repo and AUR ones;
  # without it that row simply does not appear.
  "cmd:flatpak:flatpak:flatpak apps in the same update flow as pacman and the AUR"
  "cmd:hyprsunset:hyprsunset:the eye saver (blue light filter) in settings -> displays"
)


for entry in "${optional_entries[@]}"; do
  IFS=: read -r kind target pkg desc <<<"$entry"
  if [[ $kind == cmd ]]; then
    command -v "$target" >/dev/null && present=1 || present=0
  else
    [[ -e $root$target ]] && present=1 || present=0
  fi
  if ((present)); then
    ok "$target (optional)"
  else
    warn "$target not found -- $desc (package: $pkg, optional)"
    offer "$pkg" "$desc"
  fi
done

# The update wizard's "merge..." for a .pacnew. c7up walks $DIFFPROG, then
# arch-update.conf's diff_prog, then meld, kdiff3, nvim -d, vim -d -- and with
# none of them it falls back to showing the diff read-only, which resolves
# nothing. Any one of these makes the button work, so only the empty case is
# worth a warning.
merge_tools=(meld kdiff3 nvim vim vimdiff)
have_merge=''
for t in "${merge_tools[@]}"; do command -v "$t" >/dev/null && { have_merge=$t; break; }; done
if [[ -n $have_merge ]]; then
  ok "merge tool for pacnew review ($have_merge)"
elif [[ -n ${DIFFPROG:-} ]]; then
  ok "merge tool for pacnew review (DIFFPROG=$DIFFPROG)"
else
  warn 'no merge tool -- the update wizard can show a pacnew diff but not merge it'
  # meld rather than vim: this is a graphical desktop, and a three-pane window
  # is what the wizard's "merge..." promises. vim -d is pacdiff's own default
  # and works just as well for anyone who wants it.
  offer meld 'three-pane merge for the update wizard'"'"'s pacnew review'
fi

# The password prompt's own dependencies. These are not optional -- without
# them c7-authd exits at startup and the shell falls back to hyprpolkitagent's
# dialog -- but they are libraries rather than commands, so need_cmd cannot see
# them. A missing typelib is the failure that looks like nothing at all: the
# daemon dies, the shell retries three times, and the prompt that appears is
# simply the wrong one.
if command -v python3 >/dev/null; then
  if python3 - <<'PYPROBE' 2>/dev/null
import gi
gi.require_version('Polkit', '1.0')
gi.require_version('PolkitAgent', '1.0')
from gi.repository import Polkit, PolkitAgent  # noqa: F401
PYPROBE
  then
    ok 'Polkit and PolkitAgent typelibs (the password prompt talks to PAM through them)'
  else
    bad 'the Polkit/PolkitAgent GObject typelibs are missing -- c7-authd cannot start,
       so every password prompt falls back to hyprpolkitagent'
    want_pkg polkit
    want_pkg python-gobject
  fi
fi
# The setuid helper libpolkit-agent runs to do the PAM conversation. It is the
# one part of authenticating that must be root, and it is shipped by polkit
# rather than by us.
need_file /usr/lib/polkit-1/polkit-agent-helper-1 polkit \
  'the setuid helper every polkit agent authenticates through'

# The handover. After an upgrade, hyprpolkitagent is still running from the
# session that started it, and only one agent may hold the registration -- so
# c7-authd comes up, finds the seat taken, and the prompts stay the old ones
# until the next login. That is a confusing thing to work out from a screenshot,
# so say it plainly rather than leaving someone to wonder why the new prompt
# never appeared.
if command -v pgrep >/dev/null && pgrep -x hyprpolkitagent >/dev/null 2>&1; then
  note 'hyprpolkitagent is still running, so it -- not c7shell -- is drawing password prompts.'
  note 'It is no longer autostarted; log out and back in for the shell to take over.'
fi

# Not a check: the last mile of the sudo variant, which c7shell will not do on
# anyone's behalf. hypr/conf/environment.lua sets SUDO_ASKPASS, which sudo(8)
# consults for `sudo -A` and when there is no terminal to read from. Making
# plain `sudo` in a terminal use it as well is one line in /etc/sudo.conf -- a
# file the sudo package owns, and one this project does not edit, since a
# desktop shell rewriting another package's config in /etc is how a machine
# ends up unable to authenticate at all.
if [[ -r ${root}/etc/sudo.conf ]] \
   && grep -qE '^[[:space:]]*Path[[:space:]]+askpass' "${root}/etc/sudo.conf"; then
  ok 'sudo.conf names an askpass helper'
else
  note 'to route every terminal sudo through the shell prompt, not just `sudo -A`:'
  note '  echo "Path askpass /usr/bin/c7-askpass" | sudo tee -a /etc/sudo.conf'
fi

# Let the user pick which of the absent optional packages to install. Only
# ever runs with --optional, and only with a terminal to answer on.
offer_optional() {
  ((${#offer_pkgs[@]})) || return 0
  if [[ ! -t 0 ]]; then
    note 'no terminal to ask on; install the optional packages above by hand'
    return 0
  fi

  printf '\nOptional packages that are not installed:\n\n'
  local i
  for i in "${!offer_pkgs[@]}"; do
    printf '  %2d) %-14s %s\n' "$((i + 1))" "${offer_pkgs[i]}" "${offer_desc[i]}"
    [[ -n ${companions[${offer_pkgs[i]}]:-} ]] \
      && printf '      %-14s + %s\n' '' "${companions[${offer_pkgs[i]}]}"
  done
  printf '\nPick which to install: numbers (1 3 5), ranges (1-4), a = all,\n'
  printf 'or press enter to install none: '

  local reply
  read -r reply || reply=
  reply=${reply//,/ }
  [[ -z ${reply// /} ]] && { echo 'nothing selected.'; return 0; }

  local chosen=()
  case ${reply,,} in
    a|all) chosen=("${offer_pkgs[@]}") ;;
    n|none) echo 'nothing selected.'; return 0 ;;
    *)
      local tok lo hi n
      for tok in $reply; do
        if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
          lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[2]}
        elif [[ $tok =~ ^[0-9]+$ ]]; then
          lo=$tok; hi=$tok
        else
          printf 'c7shell-doctor: not a number or range: %s\n' "$tok" >&2
          return 0
        fi
        if ((lo < 1 || hi > ${#offer_pkgs[@]} || lo > hi)); then
          printf 'c7shell-doctor: out of range: %s (there are %d)\n' "$tok" "${#offer_pkgs[@]}" >&2
          return 0
        fi
        for ((n = lo; n <= hi; n++)); do chosen+=("${offer_pkgs[n - 1]}"); done
      done
      ;;
  esac

  # Whatever was picked, bring its companions along: dolphin without
  # plasma-integration is dolphin that ignores the palette.
  local pick
  for pick in "${chosen[@]}"; do
    [[ -n ${companions[$pick]:-} ]] && chosen+=(${companions[$pick]})
  done

  # A number typed twice, or covered by a range as well, is not an error.
  local uniq=() c seen
  for c in "${chosen[@]}"; do
    seen=0
    for n in ${uniq[@]+"${uniq[@]}"}; do [[ $n == "$c" ]] && seen=1; done
    ((seen)) || uniq+=("$c")
  done

  # Two channels, because pacman cannot install an AUR package and the helper
  # must not run as root (makepkg refuses to). Split the pick rather than
  # sending everything down one of them.
  local repo=() aur=() failed=0
  for c in "${uniq[@]}"; do
    if [[ -n ${aur_only[$c]:-} ]]; then aur+=("$c"); else repo+=("$c"); fi
  done

  if ((${#repo[@]})); then
    printf '\ninstalling: %s\n' "${repo[*]}"
    as_root pacman -S --needed -- "${repo[@]}" || {
      printf 'c7shell-doctor: installing the optional packages failed.\n' >&2
      failed=1
    }
  fi

  if ((${#aur[@]})); then
    if [[ -n $aur_helper ]]; then
      printf '\ninstalling from the AUR with %s: %s\n' "$aur_helper" "${aur[*]}"
      # As the user: an AUR helper builds with makepkg, which will not run under
      # root, so as_root here would fail the build rather than authorise it.
      "$aur_helper" -S --needed -- "${aur[@]}" || {
        printf 'c7shell-doctor: %s could not install: %s\n' "$aur_helper" "${aur[*]}" >&2
        failed=1
      }
    else
      # Not a failure of the pick: everything from the repos still went in, and
      # the AUR needs a tool this machine does not have. Say what to run.
      printf '\nno working AUR helper, so these were skipped: %s\n' "${aur[*]}" >&2
      for c in "${aur[@]}"; do
        note "git clone https://aur.archlinux.org/$c.git && cd $c && makepkg -si"
      done
      failed=1
    fi
  fi

  ((failed)) || printf '\ninstalled. re-run c7shell-doctor to re-check.\n'
}

if ((fail)) && ((fix)) && ((${#missing_pkgs[@]})); then
  # c7shell itself is not a fix target: it is what is being installed.
  fixable=()
  for p in "${missing_pkgs[@]}"; do [[ $p == c7shell ]] || fixable+=("$p"); done
  if ((${#fixable[@]})); then
    printf '\ninstalling: %s\n' "${fixable[*]}"
    as_root pacman -S --needed -- "${fixable[@]}" || {
      printf 'c7shell-doctor: run as root: pacman -S --needed %s\n' "${fixable[*]}" >&2
      exit 1
    }
    printf '\nre-checking...\n'
    exec "$0" ${quiet:+--quiet} ${pending:+--setup-pending} ${optional:+--optional}
  fi
fi

((optional)) && offer_optional

printf '\n'
if ((fail)); then
  printf 'c7shell-doctor: required pieces are missing (see FAIL above).\n' >&2
  if ((${#missing_pkgs[@]})); then
    printf 'to install the packages behind them:  c7shell-doctor --fix\n' >&2
  fi
  exit 1
fi
if ((warned)); then
  echo 'c7shell-doctor: everything required is present; optional pieces are missing (see warn above).'
  ((optional)) || echo 'to pick from them:  c7shell-doctor --optional'
else
  echo 'c7shell-doctor: everything checks out.'
fi
