#!/usr/bin/env bash
# Bring an existing c7shell install up to date: rebuild the package from git,
# then refresh the configs in ~/.config without eating local edits.
#
# c7shell is built locally, so `pacman -Syu` never upgrades it -- there is no
# repository to upgrade it from. And the configs under ~/.config are copies the
# user is expected to edit, so a fix that lands in a shipped file has no way to
# reach them: c7shell-setup --force replaces them wholesale and keeps only a
# timestamped backup. This command closes both gaps.
#
# The config refresh is pacnew-style: a file you never touched is updated in
# place, a file you edited is left alone and the new shipped version is written
# next to it as <file>.new for you to merge. Which of the two it is comes from a
# manifest of the hashes last installed; with no manifest (an install from
# before this command existed) anything that differs is treated as edited,
# which is the safe direction.
set -euo pipefail

repo=${C7SHELL_REPO:-https://github.com/Jonohas/c7shell.git}
branch=${C7SHELL_BRANCH:-main}
share=${C7SHELL_SHARE:-/usr/share/c7shell}
conf=${XDG_CONFIG_HOME:-$HOME/.config}
cache=${C7SHELL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/c7shell}
state=${C7SHELL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/c7shell}
manifest=$state/manifest
# Suffix for the backups --take-shipped leaves behind. One per run, so a single
# upgrade's backups sort together.
stamp=$(date +%Y%m%d%H%M%S)

parts=(hypr quickshell/c7shell xdg-desktop-portal)
dry=0
do_package=1
do_config=1
take_shipped=0
do_doctor=1
do_greeter=1
force=0

# The greeter lives outside both halves above: the binary and its QML ship with
# the package, but which greeter greetd runs is a line in /etc/greetd/config.toml
# that no package may write, and which display manager starts at boot is a
# systemd link. A machine set up when c7shell used sddm has the files and
# neither of those, which is exactly the gap this step closes.
# Bumped whenever a step is added after the package half below, or an existing
# one changes in a way that matters on the run that installs the change. That
# half replaces this very script, so it is otherwise the *old* code that runs
# the rest -- see the hand-over after the package step.
#
# Rev 4 is the greeter step moving machines from sddm to greetd.
#
# Rev 3 is the restart step below. Rev 2 shipped a fix to it and did not bump,
# so the run that installed that fix went on using the code it replaced -- the
# report from the machine it happened on is a shell wedged on a failed load and
# a "restart it yourself" with no command in it, which is precisely the pair of
# things rev 2 had just fixed.
upgrade_revision=4
# The greetd config body and the display-manager lookup, shared with
# c7shell-bootstrap and c7shell-doctor: share/c7shell-greetd.sh. The repo layout
# answers first, so a checkout and the test suite run the copy beside them;
# an installed script falls through to /usr/lib/c7shell. A missing lib fails
# the source and `set -e` ends the run, which is right -- c7shell-upgrade
# cannot do its greeter step without it.
# Pure parameter expansion, no dirname: c7shell-doctor runs its own checks
# with PATH pointed at a fake tree, where no external command exists yet.
_c7lib=${C7SHELL_LIB:-${0%/*}/../share}
[[ -r $_c7lib/c7shell-greetd.sh ]] || _c7lib=/usr/lib/c7shell
# shellcheck source=../share/c7shell-greetd.sh
. "$_c7lib/c7shell-greetd.sh"

etc_root=${C7SHELL_ROOT:-}

usage() {
  cat <<USAGE
usage: c7shell-upgrade [options]

Rebuilds the c7shell package from git and refreshes the configs in ~/.config.
pacman cannot do the first (the package is built locally, not from a repo) and
must not do the second (the configs are yours to edit).

  -n, --dry-run        print what would change and change nothing
      --package-only   rebuild and reinstall the package, leave ~/.config alone
      --config-only    refresh ~/.config from $share, don't touch the package
      --take-shipped   resolve every config conflict in favour of the shipped
                       version, backing the local file up as <file>.bak-<stamp>.
                       For a config you have not deliberately edited -- the
                       usual case on a machine set up before the manifest
                       existed -- this is what you want.
      --no-doctor      skip the c7shell-doctor run at the end
      --no-greeter     don't point greetd at the c7shell greeter or switch
                       the display manager to it
  -f, --force          rebuild even when the installed version is current
  -h, --help           this text

Files you edited are never overwritten: the new shipped version is written
beside them as <file>.new and reported.

env: C7SHELL_REPO   (default $repo)
     C7SHELL_ROOT   prefix for the /etc and /usr paths touched (test hook)
     C7SHELL_BRANCH (default main)
     C7SHELL_SHARE  (default /usr/share/c7shell)
     C7SHELL_CACHE  (default \$XDG_CACHE_HOME/c7shell)
     C7SHELL_STATE  (default \$XDG_STATE_HOME/c7shell)

exit: 0 up to date, 1 something went wrong (no shell left running the new
      config counts), 4 updated but files need merging
USAGE
}

# The flags that still mean something to the half after the package step, kept
# for the hand-over below.
pass_on=()

while (($#)); do
  case $1 in
    -n|--dry-run) dry=1 ;;
    --package-only) do_config=0 ;;
    --config-only) do_package=0 ;;
    --take-shipped) take_shipped=1 ;;
    --no-doctor) do_doctor=0; pass_on+=(--no-doctor) ;;
    --no-greeter) do_greeter=0; pass_on+=(--no-greeter) ;;
    -f|--force) force=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'c7shell-upgrade: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ((EUID == 0)); then
  echo 'c7shell-upgrade: run this as your own user; makepkg refuses to run as root' >&2
  exit 2
fi

run() { if ((dry)); then printf '  would: %s\n' "$*"; else "$@"; fi; }
step() { printf '\n== %s\n' "$1"; }
info() { printf '   %s\n' "$1"; }
warn() { printf '   warn: %s\n' "$1" >&2; }

hash_of() { sha256sum -- "$1" | cut -d' ' -f1; }

# c7shell-setup rewrites the $HOME placeholder in xdph.conf when it copies it,
# because xdph does no variable expansion. Compare against the same rewrite or
# that one file looks locally edited on every single upgrade.
#
# hyprlock.conf the same way, but only when the config dir is not ~/.config:
# setup leaves it byte-identical in the common case. Plain bash rather than
# sed, so a '#' or '&' in the path stays data.
shipped_at() {
  local rel=$1 src=$2 text from to
  case $rel in
    hypr/xdph.conf) from='$HOME/.config/quickshell' to=$conf/quickshell ;;
    hypr/hyprlock.conf)
      [[ $conf != "$HOME/.config" ]] || { cat -- "$src"; return; }
      from='$HOME/.config/hypr/hyprlock-palette.conf' to=$conf/hypr/hyprlock-palette.conf ;;
    *) cat -- "$src"; return ;;
  esac
  text=$(<"$src")
  printf '%s\n' "${text//"$from"/"$to"}"
}

# Write the shipped file whole, then rename it into place: quickshell reloads on
# the first write it sees, and an interrupted `> "$dst"` leaves a truncated
# shell.qml behind. The shipped mode comes along, so a script stays executable.
#
# A symlinked config (stow, chezmoi) is written at its target, so the link and
# the dotfiles repo behind it stay as they are.
cur_tmp=
trap 'rm -f -- "${cur_tmp:-}"' EXIT
write_shipped() {
  local rel=$1 src=$2 dst=$3
  if [[ -L $dst ]]; then
    dst=$(readlink -f -- "$dst") || { warn "$3 is a symlink that does not resolve"; return 1; }
  fi
  cur_tmp=$dst.tmp.$$
  if shipped_at "$rel" "$src" > "$cur_tmp" && chmod --reference="$src" -- "$cur_tmp"; then
    mv -f -- "$cur_tmp" "$dst"
  else
    rm -f -- "$cur_tmp"; cur_tmp=; return 1
  fi
  cur_tmp=
}

# Files c7shell writes into the config tree at runtime rather than ships. Older
# setups recorded them in the manifest, so they look "dropped upstream" -- they
# are not, and deleting the palette leaves the lock screen without its colours.
generated() { case $1 in hypr/hyprlock-palette.conf) return 0 ;; esac; return 1; }
shipped_hash() { shipped_at "$1" "$2" | sha256sum | cut -d' ' -f1; }

# makepkg never builds when a tarball for the pkgver it computes already sits in
# the build directory: it says "A package has already been built, installing
# existing package..." and hands that file straight to pacman. An interrupted
# build leaves a half-written (often zero-length) tarball behind, and because
# pkgver() bakes the commit into the version, that file keeps matching for as
# long as the branch head does not move -- so every later run fails the same way
# with "missing package metadata ... invalid or corrupted package" and never
# rebuilds. Dropping what cannot be read is enough to break the loop.
prune_broken_packages() {
  local dir=$1 f
  [[ -d $dir ]] || return 0
  # `shopt -p` exits non-zero when the option is unset, which is most of the
  # time and is not an error here.
  local restore; restore=$(shopt -p nullglob || true)
  shopt -s nullglob
  for f in "$dir"/*.pkg.tar.*; do
    [[ $f == *.sig ]] && continue
    # bsdtar, not zstd: it reads whatever compression makepkg.conf's PKGEXT
    # chose, and it is present on any machine that can run makepkg at all.
    [[ -s $f ]] && bsdtar -tf "$f" >/dev/null 2>&1 && continue
    info "dropping an unreadable leftover package: ${f##*/}"
    run rm -f -- "$f"
  done
  eval "$restore"
}

# ---------------------------------------------------------------------------
# the package
# ---------------------------------------------------------------------------

if ((do_package)); then
  step "package"
  for cmd in git makepkg; do
    command -v "$cmd" >/dev/null || { printf 'c7shell-upgrade: %s is required\n' "$cmd" >&2; exit 1; }
  done

  src=$cache/src
  if [[ -d $src/.git ]]; then
    info "refreshing $src ($branch)"
    run git -C "$src" fetch --quiet origin "$branch"
    # Hard reset, not merge: this checkout is a build cache, not somewhere to
    # keep work, and a dirty tree here would silently build the wrong thing.
    run git -C "$src" reset --quiet --hard "origin/$branch"
  else
    info "cloning $repo ($branch) into $src"
    run mkdir -p -- "$cache"
    run git clone --quiet --branch "$branch" "$repo" "$src"
  fi

  remote_sha=$(git -C "$src" rev-parse --short HEAD 2>/dev/null || echo unknown)
  installed=$(pacman -Q c7shell 2>/dev/null | cut -d' ' -f2 || true)
  info "installed: ${installed:-not installed}"
  info "upstream:  $branch at $remote_sha"

  # pkgver() bakes the commit into the version, so the installed version tells
  # us exactly which commit is on the machine.
  if [[ -n $installed && $installed == *"g$remote_sha"* ]] && ((force == 0)); then
    info 'already the current commit, not rebuilding (use --force to rebuild anyway)'
  else
    info 'building and installing'
    prune_broken_packages "$src"
    # --no-bootstrap: this machine is already set up, this is an upgrade.
    # The doctor runs once at the end of this script instead.
    # -f: passed through to makepkg, so a *readable* tarball for this same
    # commit is rebuilt rather than reinstalled. install.sh forces this itself
    # now, but the copy that runs here is the one on the branch being built,
    # which on an older branch does not.
    if ((dry)); then
      printf '  would: (cd %s && C7SHELL_BRANCH=%s ./install.sh --no-bootstrap -f)\n' "$src" "$branch"
    else
      ( cd "$src" && C7SHELL_BRANCH=$branch C7SHELL_SKIP_DOCTOR=1 ./install.sh --no-bootstrap -f )
    fi
  fi

  # Everything after this point is code that the step above just replaced. On
  # the upgrade that introduces a step -- the sddm theme selection was the first
  # one -- the version running here predates it, so the step silently does not
  # happen and the machine ends up half upgraded: new files, old side effects.
  # So hand over to the version just installed, once, for the rest of the run.
  #
  # bash keeps reading this script from the file descriptor it opened, and pacman
  # replaces files by rename, so the running copy stays intact either way; this
  # is about which *steps* exist, not about the read.
  if ((dry == 0)) && ((do_config)) && [[ -z ${C7SHELL_HANDOVER:-} ]]; then
    installed=$(command -v c7shell-upgrade || true)
    if [[ -n $installed && -x $installed ]]; then
      # Read the marker out of the file on disk, not out of this process.
      new_rev=$(sed -n 's/^upgrade_revision=\([0-9]\+\)$/\1/p' "$installed" | head -1)
      if [[ -n $new_rev ]] && ((new_rev > upgrade_revision)); then
        info "c7shell-upgrade grew a step in this version; continuing with the new one"
        # --config-only: the package half is done, and repeating it would loop.
        C7SHELL_HANDOVER=1 exec "$installed" --config-only ${pass_on[@]+"${pass_on[@]}"}
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# the configs
# ---------------------------------------------------------------------------

conflicts=()
updated=0
added=0
removed=0
# Only a write under quickshell/ makes the running shell stale. A hypr-only
# upgrade changes nothing quickshell has loaded, and has nothing to restart for.
shell_dirty=0
# Set when the restart step could not leave a shell running the new config. It
# reaches the summary and the exit status, because the terminal that ran the
# upgrade is the only place it can: there is no bar left to notify on.
shell_failed=0
touches_shell() { case $1 in quickshell/*) shell_dirty=1 ;; esac; }

if ((do_config)); then
  step 'configs'
  for part in "${parts[@]}"; do
    [[ -d $share/$part ]] || { printf 'c7shell-upgrade: missing %s -- is the package installed?\n' "$share/$part" >&2; exit 1; }
  done

  if [[ ! -e $conf/${parts[0]} ]]; then
    info "no $conf/${parts[0]} yet -- run c7shell-setup first"
  else
    # Load the manifest of what was last installed: path<TAB>hash.
    declare -A last=()
    if [[ -f $manifest ]]; then
      while IFS=$'\t' read -r p h; do [[ -n $p ]] && last[$p]=$h; done < "$manifest"
    else
      info 'no manifest from a previous run: anything that differs is treated as'
      info 'locally edited and kept (the safe direction)'
    fi
    declare -A now=()

    for part in "${parts[@]}"; do
      while read -r src; do
        rel=${src#"$share/"}
        dst=$conf/$rel
        want=$(shipped_hash "$rel" "$src")
        now[$rel]=$want

        if [[ ! -e $dst ]]; then
          # New file in this version, or one the user deleted. Either way the
          # shipped tree is the reference and a missing file breaks imports.
          info "add     $rel"
          run mkdir -p -- "$(dirname -- "$dst")"
          if ((dry)); then printf '  would: install %s\n' "$dst"
          else write_shipped "$rel" "$src" "$dst"; fi
          touches_shell "$rel"
          ((++added))
          continue
        fi

        have=$(hash_of "$dst")
        [[ $have == "$want" ]] && continue

        if [[ ${last[$rel]:-} == "$have" ]]; then
          # Untouched since we installed it, so replacing it loses nothing.
          info "update  $rel"
          if ((dry)); then printf '  would: rewrite %s\n' "$dst"
          else write_shipped "$rel" "$src" "$dst"; fi
          touches_shell "$rel"
          ((++updated))
        elif ((take_shipped)); then
          # Asked for explicitly: the shipped file wins and the local one is
          # kept as a backup rather than thrown away.
          info "replace $rel  (yours backed up as $rel.bak-$stamp)"
          if ((dry)); then printf '  would: back up and rewrite %s\n' "$dst"
          else
            # -L: for a symlinked config the backup must hold the bytes, not
            # another link to the file write_shipped is about to replace.
            cp -aL -- "$dst" "$dst.bak-$stamp"
            write_shipped "$rel" "$src" "$dst"
            rm -f -- "$dst.new"
          fi
          touches_shell "$rel"
          ((++updated))
        else
          # Edited locally and changed upstream: keep theirs, park ours.
          if [[ -e $dst.new ]] && [[ $(hash_of "$dst.new") == "$want" ]]; then
            conflicts+=("$rel")
            continue
          fi
          info "kept    $rel  (new version written to $rel.new)"
          if ((dry)); then printf '  would: write %s.new\n' "$dst"
          else write_shipped "$rel" "$src" "$dst.new"; fi
          conflicts+=("$rel")
          # The manifest keeps the older hash on purpose: it is still the
          # version this file diverged from, which is what the next upgrade
          # needs to compare against. With no manifest at all the fallback is
          # the SHIPPED hash -- deliberately a hash the file does not have, so
          # the file stays marked divergent on every run rather than being
          # mistaken for one we installed and silently overwritten. It clears
          # itself once the user merges: then have == want and the comparison
          # above short-circuits before reaching here.
          now[$rel]=${last[$rel]:-$want}
        fi
      done < <(find "$share/$part" -type f | sort)
    done

    # Files this version dropped. Only remove what the user never touched --
    # anything else is theirs, and .bak/.new files are never ours to delete.
    for part in "${parts[@]}"; do
      [[ -d $conf/$part ]] || continue
      while read -r dst; do
        rel=${dst#"$conf/"}
        [[ -n ${now[$rel]:-} ]] && continue
        [[ $rel == *.new || $rel == *.bak-* || $rel == *.tmp.* ]] && continue
        generated "$rel" && continue
        if [[ ${last[$rel]:-} == "$(hash_of "$dst")" ]]; then
          info "remove  $rel  (dropped upstream)"
          run rm -f -- "$dst"
          touches_shell "$rel"
          ((++removed))
        else
          warn "$rel is no longer shipped but differs from what we installed -- left alone"
        fi
      done < <(find "$conf/$part" -type f | sort)
    done

    if ((dry)); then
      info "would record the manifest at $manifest"
    else
      mkdir -p -- "$state"
      # Built aside and renamed: a half-written manifest marks every file
      # after the cut as locally edited.
      for rel in "${!now[@]}"; do printf '%s\t%s\n' "$rel" "${now[$rel]}"; done \
        | sort > "$manifest.tmp.$$"
      cur_tmp=$manifest.tmp.$$
      mv -f -- "$manifest.tmp.$$" "$manifest"
      cur_tmp=
    fi

    if ((${#conflicts[@]})); then
      warn "${#conflicts[@]} config file(s) were left as they are and the new"
      warn 'versions parked beside them as .new -- your config is now part one'
      warn 'version and part another.'
      # Not a style note: QML resolves imports across the whole tree, so an old
      # shell.qml next to a new module directory fails the entire load and the
      # desktop comes up with no bar at all.
      warn 'a mixed config can fail to load outright, not just look wrong.'
      info 'to take the shipped versions (yours are backed up):'
      info '  c7shell-upgrade --config-only --take-shipped'
      info 'or merge them yourself, then delete the .new files.'
    fi

    ((added || updated || removed || ${#conflicts[@]})) \
      || info 'configs already match the installed version'
  fi
fi

# ---------------------------------------------------------------------------
# the running shell
# ---------------------------------------------------------------------------

# The config half rewrites ~/.config one file at a time and quickshell watches
# that tree, so it hot-reloads on the first file written and then runs the rest
# of the copy against a tree that is half the old version and half the new one.
# That window is where a module which gained a binding in this upgrade meets the
# service that has not gained the property yet -- "Cannot read property 'length'
# of undefined", "orphanNames is not a function" -- and the shell can settle
# there, because the reload it keeps is whichever one the watcher fired last,
# not the one that saw the finished tree. There is nothing worth preserving in a
# half-migrated shell, so it is restarted onto the whole one.
#
# Matched by config path rather than by name: `qs kill -c c7shell` would also
# reach an instance running somebody else's tree, and this must never kill a
# shell whose files this run did not touch (tests/test-upgrade.sh runs the whole
# config half against a temporary $XDG_CONFIG_HOME, on a machine whose real
# shell is up).
shell_config=$conf/quickshell/c7shell/shell.qml
shell_running() { qs list --all 2>/dev/null | grep -qF "Config path: $shell_config"; }

# The pids behind that, for when asking has not worked. `qs list` groups the
# process id and the config path under one Instance block, so the id is
# whichever one was last seen above the path we are looking for.
shell_pids() {
  qs list --all 2>/dev/null | awk -v cfg="  Config path: $shell_config" '
    /^[[:space:]]*Process ID:/ { pid = $NF }
    $0 == cfg && pid != "" { print pid; pid = "" }'
}

# Wait for `qs list` to agree with what we just did. Six seconds: a shell exits
# in well under one and comes up in about one, and anything past that is not a
# delay, it is the thing this waits to find out about. Overridable only so the
# test suite can drive the give-up branches without waiting them out.
wait_ticks=${C7SHELL_WAIT_TICKS:-30}
wait_gone()  { local _; for _ in $(seq "$wait_ticks"); do shell_running || return 0; sleep 0.2; done; return 1; }
wait_there() { local _; for _ in $(seq "$wait_ticks"); do shell_running && return 0; sleep 0.2; done; return 1; }

# The command this step relaunches the shell with, quoted so it can be pasted.
# Kept beside the launch below; the two must not drift. At login the shell runs
# under c7shell-session instead, which relaunches it after a crash.
shell_argv='QT_WAYLAND_DISABLE_WINDOWDECORATION=1 setsid qs -c c7shell -d -n'

# Every branch that ends with nothing drawing the desktop comes through here.
# "restart it yourself, or log out and back in" was the whole of the old
# advice, and it is the one instruction in this command that needs an actual
# command attached. A session that started on an older config has no
# c7shell-session, and one whose supervisor gave up on a crash loop has none
# left, so there is no service to start and no obvious thing to retype.
restart_hint() {
  info 'start it again, supervised so a crash brings it back:'
  info '  setsid c7shell-session >/dev/null 2>&1 &'
  info 'or once, without supervision:'
  info "  $shell_argv"
  info 'or log out and back in. if it exits straight away, run it in the'
  info 'foreground to see why:  qs -c c7shell'
  info "the last run's log is kept too:  qs log -c c7shell"
}

if ((shell_dirty)) && command -v qs >/dev/null; then
  step 'restarting the shell'
  if ((dry)); then
    if shell_running; then
      info "would restart the quickshell instance running $shell_config"
    else
      info "would report that nothing is running $shell_config"
    fi
  elif ! shell_running; then
    # Not a failure: an upgrade over ssh or from a TTY has no shell to restart,
    # and this step used to say nothing at all in that case. It is worth a line
    # anyway, because the other way to arrive here is a shell that already died
    # on the half-copied tree -- and then this is the message that gets the
    # desktop back.
    info "nothing is running $shell_config, so there is nothing to restart"
    restart_hint
  else
    # By pid rather than `qs kill -c c7shell`: the note above about never
    # touching a shell this run did not touch applies to the polite request as
    # much as to the signal, and a config name matches somebody else's tree.
    for pid in $(shell_pids); do qs kill --pid "$pid" >/dev/null 2>&1 || true; done
    # The relaunch is --no-duplicate, so wait for the old one to actually be
    # gone: two shells drawing the same bars is worse than one stale shell.
    #
    # `qs kill` is a request, though, and a shell can take its windows down and
    # then wedge on the way out -- the instance is still listed, still holding
    # the name the relaunch needs, and the desktop it was drawing is already
    # gone. Leaving that alone used to be the cautious branch. It is not: it is
    # a session with no bar and no launcher until the user logs out, which is
    # worse than either outcome the caution was weighing. So the request
    # escalates to the process behind it.
    if ! wait_gone; then
      mapfile -t stuck < <(shell_pids)
      if ((${#stuck[@]})); then
        info "the shell has not exited -- signalling ${stuck[*]}"
        kill -TERM "${stuck[@]}" 2>/dev/null || true
        wait_gone || { kill -KILL "${stuck[@]}" 2>/dev/null || true; wait_gone || true; }
      fi
    fi

    if shell_running; then
      warn 'the running shell will not exit, not even on SIGKILL -- it is still'
      warn 'on the old config, and the relaunch is --no-duplicate, so it would'
      warn 'decline to start beside it'
      restart_hint
      shell_failed=1
    else
      # c7shell-session relaunches the shell too, but a session started on an
      # older config has no supervisor, and the relaunch is --no-duplicate:
      # whichever comes up first wins and the other declines. Same environment
      # as the shell gets at login, detached so it outlives this terminal.
      QT_WAYLAND_DISABLE_WINDOWDECORATION=1 setsid qs -c c7shell -d -n >/dev/null 2>&1 &
      # And then check, because "restarted" is the one line in this whole
      # command the user acts on by walking away. A launch that failed and said
      # nothing is how you find out at the next reboot that you have no shell.
      #
      # Twice, a second apart: a configuration that loads and then fails on its
      # first reload registers an instance and drops it again, so one look can
      # report a shell that lasted 200ms.
      if wait_there && { sleep 1; shell_running; }; then
        info 'restarted onto the new config'
      else
        warn 'the shell did not come up on the new config'
        info 'the configuration it was handed fails to load -- see the error:'
        info '  qs -c c7shell'
        if ((${#conflicts[@]})); then
          info 'you have .new files left to merge (listed at the end): a config'
          info 'that is half yours and half shipped is a load failure by itself.'
        fi
        shell_failed=1
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# the greeter theme
# ---------------------------------------------------------------------------

greeter_note=''

as_root() {
  if ((dry)); then printf '  would run (root): %s\n' "$*"; return 0; fi
  if command -v sudo >/dev/null; then sudo "$@"
  elif command -v doas >/dev/null; then doas "$@"
  else
    warn "need root to run: $*"
    return 1
  fi
}

if ((do_greeter)); then
  # greetd runs the greeter as a binary rather than loading QML, so there is no
  # theme to select -- only a config telling greetd what to run, and greetd
  # being the display manager that starts at boot.
  step 'greeter'
  greetd_ours=0
  if [[ ! -x $etc_root/usr/bin/c7shell-greeter ]]; then
    info 'c7shell-greeter is not installed -- greetd is left alone'
  elif greetd_is_c7shell "$etc_root"; then
    info 'greetd already runs the c7shell greeter'
    greetd_ours=1
  elif ! greetd_config_replaceable "$etc_root"; then
    # Someone chose another greeter on purpose; it is theirs to undo.
    info "greetd runs another greeter -- $GREETD_CONFIG is left alone"
    greeter_note="to run the c7shell greeter instead, replace $GREETD_CONFIG with: c7shell-bootstrap"
  else
    info "pointing greetd at the c7shell greeter in $GREETD_CONFIG"
    greetd_ours=1
    if ((dry)); then
      printf '  would write %s\n' "$etc_root$GREETD_CONFIG"
    else
      as_root mkdir -p "$etc_root/etc/greetd"
      greetd_config_body | as_root tee "$etc_root$GREETD_CONFIG" >/dev/null \
        || warn "could not write $etc_root$GREETD_CONFIG"
    fi
  fi

  if ((greetd_ours)); then
    # Written as user greeter into root-owned directories, so both must exist
    # and belong to it before greetd starts: without the log the stderr
    # redirect fails before cage is exec'd and nothing is drawn; without the
    # state directory the greeter never preselects an account. Only when the
    # user exists -- it comes with greetd's package.
    if ((dry)); then
      printf '  would create /var/lib/c7shell-greeter and /var/log/c7greeter.log, owned by greeter\n'
    elif getent passwd greeter >/dev/null 2>&1; then
      as_root install -dm755 -o greeter -g greeter "$etc_root/var/lib/c7shell-greeter" \
        || warn 'could not create /var/lib/c7shell-greeter owned by greeter'
      [[ -e $etc_root/var/log/c7greeter.log ]] \
        || as_root install -Dm600 -o greeter -g greeter /dev/null "$etc_root/var/log/c7greeter.log" \
        || warn 'could not create /var/log/c7greeter.log; the greeter may not start'
    fi

    # c7shell used to set machines up with sddm. Move those to greetd, and set
    # greetd up where no display manager is enabled at all. Any other display
    # manager was somebody's choice and is only advised about. Enabled, not
    # started: starting it would take the console away mid-upgrade, so it
    # takes over at the next boot.
    dm=$(c7shell_display_manager "$etc_root")
    case $dm in
      greetd) ;;
      sddm)
        info 'switching the display manager from sddm to greetd (at the next boot)'
        if as_root systemctl disable sddm.service && as_root systemctl enable greetd.service; then
          greeter_note='greetd takes over at the next boot -- the login screen is then the c7shell greeter'
        else
          warn 'could not switch from sddm to greetd; to do it by hand:'
          warn '  sudo systemctl disable sddm.service && sudo systemctl enable greetd.service'
        fi
        ;;
      '')
        info 'no display manager is enabled -- enabling greetd (at the next boot)'
        if as_root systemctl enable greetd.service; then
          greeter_note='greetd takes over at the next boot -- the login screen is then the c7shell greeter'
        else
          warn 'could not enable greetd.service; to do it by hand: sudo systemctl enable greetd.service'
        fi
        ;;
      *)
        info "the display manager is $dm -- left alone"
        greeter_note="to use the c7shell greeter: sudo systemctl disable $dm.service && sudo systemctl enable greetd.service"
        ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------

if ((do_doctor)) && ((dry == 0)) && command -v c7shell-doctor >/dev/null; then
  step 'checking the requirements'
  c7shell-doctor --quiet || true
fi

step 'summary'
((do_config)) && info "added $added, updated $updated, removed $removed, kept ${#conflicts[@]}"
if [[ -n $greeter_note ]]; then info "$greeter_note"; fi
if ((shell_failed)); then
  warn 'nothing is running the new config -- the package and the configs are'
  warn 'updated, but the desktop is stale or has no bar at all'
  restart_hint
fi
if ((${#conflicts[@]})); then
  printf '\nThese files you had edited, and the shipped version changed too. Yours is\nuntouched; the new one is beside it as <file>.new:\n\n'
  for rel in "${conflicts[@]}"; do printf '  %s\n' "$conf/$rel"; done
  printf '\nMerge with e.g.:  diff -u %s/%s{,.new}\n' "$conf" "${conflicts[0]}"
  ((dry)) && exit 0
  exit 4
fi
((dry)) && { printf '\n--dry-run: nothing was changed.\n'; exit 0; }
((shell_failed)) && exit 1
echo
echo 'Up to date. Log out and back in to pick up a new session entry or config.'
