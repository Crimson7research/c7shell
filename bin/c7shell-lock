#!/usr/bin/env python3
"""Draw the lock screen's backdrop decoration, then hand over to hyprlock.

The design doc puts two things behind the lock screen that hyprlock cannot
draw: a radial glow in the accent rising from the bottom edge, and a 56px grid.
It has no gradients and no tiling -- but it does have an `image` widget, and an
image sized to the screen is exactly those two things.

An image has to be authored at the screen's own size. `image:size` is a single
int and the aspect ratio is preserved, so a PNG with the screen's aspect and
size = min(width, height) lands at exactly 1:1; anything else would rescale the
grid into a different cell size on every machine. That is why this is a program
that runs at lock time rather than a file shipped in the package: it is the only
moment the monitor list is known.

Those numbers are the monitor's PIXELS, not its logical size. hyprlock lays
widgets out in buffer coordinates -- CSessionLockSurface::configure sets
`size = size_ * POUTPUT->scale` and COutput::getViewport returns that -- so on a
2560x1600 panel at scale 2 the viewport is 2560x1600, not 1280x800. Sizing the
overlay in logical units drew it at half scale, centred, covering a quarter of
the screen.

Everything here is best-effort. A lock screen that does not appear is far worse
than one without decoration, so any failure at all -- no hyprctl, no monitors,
an unwritable cache, a malformed config -- falls through to running hyprlock
exactly as if this program did not exist.
"""

import json
import math
import os
import re
import struct
import subprocess
import sys
import zlib

# The mockup's canvas is 1120x630 and everything on the lock screen is drawn at
# 1.2x of it, matching what the greeter's Theme.qml resolves to on 1080p.
SCALE = 1.2
GRID_PX = 56          # mockup units; multiplied by SCALE below
GRID_RGB = (255, 255, 255)
GRID_ALPHA = 0.018
# radial-gradient(900px 520px at 50% 118%, rgba(229,58,68,.2), transparent 68%)
# Kept as fractions of the canvas rather than pixels so the glow lands in the
# same place on any screen; the grid stays absolute, because a grid that scales
# with the screen is not a grid.
# The default crimson only: the accent is appearance.json's, read below, the
# same way the lock screen's own palette follows it (hyprlock-palette.conf,
# written by scripts/c7shell-theme-export.py). A green desktop with a crimson
# glow under its lock screen is the bug this shares with that file.
GLOW_RGB = (0xE5, 0x3A, 0x44)
GLOW_RX, GLOW_RY = 900 / 1120, 520 / 630
GLOW_CX, GLOW_CY = 0.50, 1.18
GLOW_PEAK, GLOW_STOP = 0.20, 0.68


def png(width, height, rows):
    def chunk(tag, data):
        body = tag + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))

    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(b"".join(rows), 6))
        + chunk(b"IEND", b"")
    )


def accent(conf):
    """appearance.json's accent as (r, g, b), or the default crimson.

    Hand-editable, so it is treated as untrusted the way AppearanceStore's
    clamped reads and the exporter's are: anything that is not six hex digits
    falls back rather than reaching the glow.
    """
    try:
        with open(os.path.join(conf, "hypr", "appearance.json"), encoding="utf-8") as f:
            data = json.load(f)
        value = data["accent"] if isinstance(data, dict) else None
    except (OSError, ValueError, KeyError):
        return GLOW_RGB
    if not (isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value)):
        return GLOW_RGB
    c = value.lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def overlay(width, height, glow=GLOW_RGB):
    """The grid and the glow, as RGBA scanlines with a PNG filter byte."""
    # Physical pixels, like everything else hyprlock lays out: the grid has to
    # match the type in hyprlock.conf, which is authored in the same units.
    step = max(1, round(GRID_PX * SCALE))
    ga = GRID_ALPHA
    gr, gg, gb = GRID_RGB
    cr, cg, cb = glow
    rx, ry = GLOW_RX * width, GLOW_RY * height
    cx, cy = GLOW_CX * width, GLOW_CY * height
    ga8 = int(ga * 255 + 0.5)

    # Rows outside the glow's reach are one of two constant patterns, so they
    # are built once and reused. On a 1600px-tall screen that is most of the
    # image, and it is the difference between this taking a moment and taking
    # long enough to notice before the screen locks.
    clear_px = bytes(4)
    grid_px = bytes((gr, gg, gb, ga8))
    plain_row = bytes([0]) + b"".join(
        grid_px if x % step == 0 else clear_px for x in range(width)
    )
    grid_row = bytes([0]) + grid_px * width

    # d < GLOW_STOP bounds the glow to a box; outside it there is nothing to mix.
    reach = GLOW_STOP * ry
    rows = []
    for y in range(height):
        if abs(y - cy) >= reach:
            rows.append(grid_row if y % step == 0 else plain_row)
            continue
        dy = (y - cy) / ry
        dy2 = dy * dy
        on_grid_row = y % step == 0
        row = bytearray([0])
        for x in range(width):
            dx = (x - cx) / rx
            d = math.sqrt(dx * dx + dy2)
            a = GLOW_PEAK * (1.0 - d / GLOW_STOP) if d < GLOW_STOP else 0.0
            r, g, b = cr, cg, cb
            if on_grid_row or x % step == 0:
                # Grid over glow, resolved back to straight (non-premultiplied)
                # alpha, which is what a PNG stores.
                na = a + ga * (1 - a)
                if na > 0:
                    r = int((cr * a + gr * ga * (1 - a)) / na)
                    g = int((cg * a + gg * ga * (1 - a)) / na)
                    b = int((cb * a + gb * ga * (1 - a)) / na)
                a = na
            row += bytes((r, g, b, int(a * 255 + 0.5)))
        rows.append(bytes(row))
    return png(width, height, rows)


def monitors():
    out = subprocess.run(
        ["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=5
    )
    if out.returncode != 0:
        return []
    found = []
    for m in json.loads(out.stdout):
        name, w, h = m.get("name"), int(m.get("width", 0)), int(m.get("height", 0))
        s = float(m.get("scale", 1) or 1)
        if name and w > 0 and h > 0 and s > 0:
            found.append((name, w, h, s))
    return found


# hyprlock's fingerprint auth talks to fprintd itself, but switched on with no
# finger enrolled it puts a "scan fingerprint" line under every lock for a
# reader that will never match. hyprlang has no conditionals, so the block is
# appended here, at lock time, only once fprintd-list shows an enrolled finger.
FINGERPRINT_BLOCK = """
# ---- fingerprint (fprintd-list shows an enrolled finger) ----
auth {
    fingerprint {
        enabled = true
        ready_message = or touch the sensor
        present_message = scanning...
    }
}
label {
    monitor =
    zindex = 1
    text = $FPRINTPROMPT
    font_family = $mono
    font_size = 11
    color = $ink4
    position = 0, -72
    halign = center
    valign = center
}
"""


def fingerprint_enrolled():
    """True only when fprintd answers, quickly, with at least one finger.

    No fprintd, no reader, a slow D-Bus activation: all of them are "no", and
    the lock screen is password-only exactly as before.
    """
    try:
        out = subprocess.run(
            ["fprintd-list", os.environ.get("USER") or os.getlogin()],
            capture_output=True, text=True, timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return out.returncode == 0 and re.search(r"^\s*- #\d+:", out.stdout, re.M) is not None


def reader_out_of_reach():
    """Lid shut on a dock (logind's LidClosed and Docked): the sensor is under
    the lid, so the lock screen stays password-only. A shut lid without a dock
    is the lock before suspend, and the lid opens again on the print.
    """
    def prop(name):
        out = subprocess.run(
            ["busctl", "get-property", "org.freedesktop.login1", "/org/freedesktop/login1",
             "org.freedesktop.login1.Manager", name],
            capture_output=True, text=True, timeout=2,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"
    try:
        return prop("LidClosed") and prop("Docked")
    except (OSError, subprocess.SubprocessError):
        return False


def main():
    argv = sys.argv[1:]
    conf = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    cache = os.path.join(cache, "c7shell")
    src = os.path.join(conf, "hypr", "hyprlock.conf")

    plain = ["hyprlock", *argv]
    try:
        # An explicit --config is the caller overriding us; decorating someone
        # else's config would be a surprise.
        if "--config" in argv or "-c" in argv:
            os.execvp("hyprlock", plain)

        with open(src, "r") as f:
            base = f.read()
        mons = monitors()
        if not mons:
            os.execvp("hyprlock", plain)

        os.makedirs(cache, exist_ok=True)
        glow = accent(conf)
        # The accent is part of the name because these are cached: keyed on the
        # monitor alone, the first PNG written would be reused for every later
        # accent. Which means a new file per accent picked, so the ones drawn
        # for another accent are dropped below -- each is a screen-sized RGBA
        # image, and nothing else would ever collect them. Overlays of monitors
        # not connected right now stay: docking would otherwise pay the slow
        # render again on the next lock.
        tint = "".join(f"{v:02x}" for v in glow)
        blocks = []
        for name, w, h, s in mons:
            # Authored at, and sized in, the monitor's real pixels.
            path = os.path.join(cache, f"lock-overlay-{name}-{w}x{h}-{tint}.png")
            if not os.path.exists(path):
                tmp = path + ".tmp"
                with open(tmp, "wb") as f:
                    f.write(overlay(w, h, glow))
                os.replace(tmp, path)
            blocks.append(
                "image {\n"
                f"    monitor = {name}\n"
                f"    path = {path}\n"
                # The viewport is in pixels, so this is too: with the PNG at the
                # monitor's own size, min(w, h) makes hyprlock's
                # max(size/tex.x, size/tex.y) come out at exactly 1.
                f"    size = {min(w, h)}\n"
                "    position = 0, 0\n"
                "    halign = center\n"
                "    valign = center\n"
                # Both defaults are hostile here: rounding = -1 means a circle,
                # and border_size = 4 draws a light grey frame round the screen.
                "    rounding = 0\n"
                "    border_size = 0\n"
                # Above the background (-1), below everything the config puts at
                # 1. Widgets sharing a zindex are not sorted stably, so every
                # layer names its own.
                "    zindex = 0\n"
                "}\n"
            )

        for stale in os.listdir(cache):
            if stale.startswith("lock-overlay-") and not stale.endswith(f"-{tint}.png"):
                try:
                    os.unlink(os.path.join(cache, stale))
                except OSError:
                    pass

        merged = os.path.join(cache, "hyprlock-generated.conf")
        tmp = merged + ".tmp"
        with open(tmp, "w") as f:
            f.write(
                "# Generated by c7shell-lock at lock time -- edits are lost.\n"
                f"# Source: {src}\n\n"
            )
            f.write(base)
            f.write("\n# ---- backdrop decoration (design doc turn 11) ----\n")
            f.write("".join(blocks))
            if fingerprint_enrolled() and not reader_out_of_reach():
                f.write(FINGERPRINT_BLOCK)
        os.replace(tmp, merged)

        os.execvp("hyprlock", ["hyprlock", "--config", merged, *argv])
    except Exception as e:
        # Deliberately not fatal, and deliberately noisy in the journal only.
        print(f"c7shell-lock: falling back to plain hyprlock: {e}", file=sys.stderr)

    try:
        os.execvp("hyprlock", plain)
    except OSError as e:
        # Nothing can lock the screen. Say so where the person is looking:
        # a traceback in the journal reads as a lock that worked.
        msg = f"hyprlock could not start ({e.strerror}); the screen is NOT locked"
        print(f"c7shell-lock: {msg}", file=sys.stderr)
        try:
            subprocess.run(["notify-send", "-u", "critical", "Lock failed", msg],
                           timeout=5, check=False)
        except (OSError, subprocess.SubprocessError):
            pass
        sys.exit(1)


if __name__ == "__main__":
    main()
