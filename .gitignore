# makepkg working files
/src/
/pkg/
# cmake -S plugin -B build
/build/
*.pkg.tar.*
*.src.tar.*
/c7shell/

# written at runtime by the settings app, regenerated from conf/appearance.lua
hypr/appearance.json

# local agent/tooling state, never part of a release
.claude/*
!.claude/skills/
.superpowers/
graphify-out/
docs/plans/
docs/specs/

# python bytecode
__pycache__/
*.pyc

# generated by tools/qml-preview on every run, never committed
quickshell/c7shell/PreviewRegistry.qml

# cargo build (plugin/.cargo/config.toml sets target-dir)
/target/
# cargo --manifest-path plugin/Cargo.toml from the root, which skips that
# config; tests/test-c7-plugin.sh check 1 skips this directory too
/plugin/target/
